   {
    "number": 1,
    "provider": "js_eval",
    "name": "invoke_custom_js_code",
    "as": "ae02a6e8",
    "title": null,
    "description": "Execute <span class=\"provider\">JavaScript</span> code: <span class=\"provider\">Get start and end date</span>",
    "keyword": "action",
    "dynamicPickListSelection": {},
    "toggleCfg": {},
    "input": {
     "code": "exports.main = () => {\n  // function to help zero pad numbers when needed\n  const zeroPad = num => (num < 10 ? `0${num}` : `${num}`);\n  \n  // get today and the current day of the week\n  const today = new Date();\n  // we can shift this as needed!\n  today.setDate(today.getDate() - 7);\n  const dayOfWeek = today.getDay();\n  \n  // calculate diff to monday and create a new date object\n  // representing the start of this week\n  const diffToMonday = today.getDay() - 1;\n  let startOfWeek = new Date(today);\n  startOfWeek.setDate(startOfWeek.getDate() - diffToMonday);\n  \n  // get the values that we will use for building our final\n  // start of week date object\n  const startYear = startOfWeek.getFullYear();\n  const startMonth = zeroPad(startOfWeek.getMonth() + 1);\n  const startDay = zeroPad(startOfWeek.getDate());\n  \n  // create start date and use the startDate to get the end date 6 days (aka one week later since the weeks in timesheets go from mon - sun)\n  const startDate = new Date(`${startYear}-${startMonth}-${startDay}T16:00:00.000Z`);\n  const endDate = new Date(startDate);\n  endDate.setDate(endDate.getDate() + 6);\n  \n  // return the dates as iso strings to be used in our graphql requests\n  return { startDate: startDate.toISOString(), endDate: endDate.toISOString() };\n}",
     "name": "Get start and end date",
     "code_output_schema_json": "[{\"name\":\"startDate\",\"type\":\"string\",\"optional\":false,\"label\":\"Start date\",\"control_type\":\"text\"},{\"name\":\"endDate\",\"type\":\"string\",\"optional\":false,\"label\":\"End date\",\"control_type\":\"text\"}]"
    },
    "extended_output_schema": [
     {
      "label": "Output",
      "name": "output",
      "properties": [
       {
        "control_type": "text",
        "label": "Start date",
        "name": "startDate",
        "type": "string",
        "optional": false
       },
       {
        "control_type": "text",
        "label": "End date",
        "name": "endDate",
        "type": "string",
        "optional": false
       }
      ],
      "type": "object"
     }
    ],
    "extended_input_schema": [
