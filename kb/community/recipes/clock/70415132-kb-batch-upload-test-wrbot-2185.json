     {
      "number": 7,
      "provider": "workato_custom_code",
      "name": "invoke_custom_ruby_code",
      "as": "3ac69da6",
      "keyword": "action",
      "input": {
       "code": "require 'digest'\n\n# Get file content\nraw_content = input['file_content'] || input.dig('Input', 'Data', 'file_content') || input.dig('input', 'file_content')\n\nraise \"Missing content input\" if raw_content.to_s.strip.empty?\n\n# Parse header + body\nlines = raw_content.split(/\\r?\\n/)\ntitle      = lines[0].to_s.split(\": \", 2)[1].to_s.strip rescue \"Untitled\"\nurl        = lines[1].to_s.split(\": \", 2)[1].to_s.strip rescue nil\ntags_str   = lines[2].to_s.split(\": \", 2)[1].to_s.strip rescue nil\nupdated_at = lines[3].to_s.split(\": \", 2)[1].to_s.strip rescue nil\n\n# Body = everything after metadata lines\nbody = lines[4..]&.join(\"\\n\").to_s.strip\n\n# Extract doc_id from URL\ndoc_id = url.to_s.split('/doc/')[1] || \"doc_#{Time.now.to_i}\"\n\n# Return structured result\n{\n  doc_id: doc_id,\n  title: title,\n  url: url,\n  tags: (tags_str || \"\").split(\",\").map(&:strip).reject(&:empty?),\n  updated_at: updated_at,\n  body: body,\n  body_length: body.length\n}\n",
       "name": "split file content",
       "code_input": {
        "schema": "[{\"name\":\"file_content\",\"type\":\"string\",\"optional\":true,\"label\":\"file_content\",\"details\":{\"real_name\":\"file_content\"},\"control_type\":\"text\",\"parent\":[\"code_input\",\"data\"]}]"
       }
      },
      "extended_output_schema": [
       {
        "label": "Output",
        "name": "output",
        "properties": [],
        "type": "object"
       }
      ],
      "extended_input_schema": [
       {
        "control_type": "form-schema-builder",
        "label": "Input",
        "name": "code_input",
        "optional": true,
        "override": true,
        "properties": [
