    "name": "run_custom_sql",
    "as": "268d836b",
    "title": null,
    "description": null,
    "keyword": "action",
    "dynamicPickListSelection": {},
    "toggleCfg": {},
    "input": {
     "sql": "merge into prod_sfdc_opportunities as t\n  using #{_('data.workato.job_context.parameters.temp_table_name')} as s\n  on t.id = s.id\n  when matched then update set (\n    t.name = s.name,\n    (case\n      when s.stage = 'closedWon' then t.stage = 'closed'\n      else 'others'\n    end),\n    t.amount = s.amount\n  )\n  when not matched then insert (\n    id, name, stage, amount\n  ) values (\n    s.id,\n    s.name,\n    (case\n      when s.stage = 'closedWon' then = 'closed'\n      else 'others'\n    end),\n    s.amount\n  );"
    },
    "extended_output_schema": [
     {
      "type": "array",
      "name": "rows",
      "label": "Rows",
      "of": "object",
      "properties": []
     },
     {
      "type": "integer",
      "name": "rows_affected",
      "control_type": "number",
      "label": "Rows affected",
      "parse_output": "integer_conversion"
     }
    ],
    "hidden_config_fields": [
     "output_schema"
    ],
    "comment": "Load into prod table",
    "uuid": "da39d870-4efe-4f98-8311-ec878ab77194"
   },
