 "code": {
  "number": 0,
  "provider": "infusionsoft",
  "name": "new_payment_v2",
  "as": "new_payment_v2",
  "keyword": "trigger",
  "dynamicPickListSelection": {},
  "toggleCfg": {},
  "input": {
   "all_payments": "true"
  },
  "filter": {
   "conditions": [
    {
     "operand": "greater_than",
     "lhs": "=_('data.infusionsoft.new_payment_v2.PayDate').to_date",
     "rhs": "=_('data.workato.job_context.parameters.start_date').to_date"
    },
    {
     "operand": "not_contains",
     "lhs": "=_('data.infusionsoft.new_payment_v2.PayNote').presence  or \"blank\"",
     "rhs": "Xero Payment ID"
    },
    {
     "operand": "not_equals_to",
     "lhs": "#{_('data.infusionsoft.new_payment_v2.PayType')}",
     "rhs": "Refund"
    }
   ],
   "operand": "and",
   "type": "compound"
  },
  "parameters_schema": "[\n  {\n    \"label\": \"Start date\",\n    \"name\": \"start_date\",\n    \"type\": \"date\",\n    \"control_type\": \"date\",\n    \"hint\": \"Set the date from when you want to process records from. by clicking on the <strong>calendar icon </strong> to the left.<br><em>(For example: setting it to 12/02/2015 will pick up all invoices created or updated since that date.)<em>\"\n  },\n  {\n    \"label\": \"Payment Account Code\",\n    \"name\": \"PaymentAccountCode\",\n    \"type\": \"string\",\n    \"control_type\": \"text\",\n    \"hint\": \"Specify the Xero Account Code to link to for the payments. For example 2500 for the Suspense account\"\n  },\n  {\n    \"label\": \"Credit Account Code\",\n    \"name\": \"CreditAccountCode\",\n    \"type\": \"string\",\n    \"control_type\": \"text\",\n    \"hint\": \"Specify the Xero Account Code to link to for the credits. For example 2500 for the Suspense account\"\n  }\n   ]",
  "param": {},
