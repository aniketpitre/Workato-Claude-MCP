       "activity_description": "#{_dp('{\"pill_type\":\"output\",\"provider\":\"neto_connector_3082925_1703123108\",\"line\":\"84b4b757\",\"path\":[\"ShipFirstName\"]}')} #{_dp('{\"pill_type\":\"output\",\"provider\":\"neto_connector_3082925_1703123108\",\"line\":\"84b4b757\",\"path\":[\"ShipLastName\"]}')} placed a new order #{_dp('{\"pill_type\":\"output\",\"provider\":\"neto_connector_3082925_1703123108\",\"line\":\"84b4b757\",\"path\":[\"OrderID\"]}')} on Neto",
       "Message": "Hi, #{_dp('{\"pill_type\":\"output\",\"provider\":\"neto_connector_3082925_1703123108\",\"line\":\"84b4b757\",\"path\":[\"ShipFirstName\"]}')}, thank you for your recent order #{_dp('{\"pill_type\":\"output\",\"provider\":\"neto_connector_3082925_1703123108\",\"line\":\"84b4b757\",\"path\":[\"OrderID\"]}')} with {{ business_name }}.\n\nWe've got your order and will begin processing. You will get tracking updates from us. You can also reply to this sms for any questions."
      }
