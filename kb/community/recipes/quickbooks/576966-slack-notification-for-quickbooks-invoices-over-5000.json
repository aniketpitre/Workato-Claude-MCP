 "config": [],
 "code": {
  "number": 0,
  "provider": "quickbooks",
  "name": "new_invoice",
  "as": "new_invoice",
  "title": null,
  "description": null,
  "keyword": "trigger",
  "dynamicPickListSelection": {},
  "toggleCfg": {
   "filter_unused_lines": true
  },
  "input": {
   "filter_unused_lines": "true",
   "since": "=today"
  },
  "filter": {
   "conditions": [
    {
     "operand": "greater_than",
     "lhs": "#{_('data.quickbooks.new_invoice.TotalAmt')}",
     "rhs": "5000"
    }
   ],
   "operand": "and",
   "type": "compound"
  },
  "extended_output_schema": [
   {
    "type": "string",
    "name": "Custom_fields_custom",
    "control_type": "text",
    "label": "Custom fields",
    "optional": true,
    "custom": true,
    "definition": {
     "DefinitionId": "1",
     "Name": "Custom fields",
     "Type": "StringType"
    }
   }
  ],
  "parameters_schema": "[\n  {\n    \"label\": \"Channel name\",\n    \"name\": \"channel\",\n    \"type\": \"string\",\n    \"control_type\": \"text\",\n    \"hint\": \"Channel to receive notifications from this recipe\"\n  }\n]",
  "param": {},
  "block": [
   {
    "number": 1,
    "provider": "slack",
    "name": "post_message_to_channel",
    "as": "post_message_to_channel",
    "keyword": "action",
    "dynamicPickListSelection": {},
    "toggleCfg": {
     "channelSource2": true
    },
    "input": {
     "color": "good",
     "attachment_text": "=\"Due on: \" + (_('data.quickbooks.new_invoice.DueDate') ? _('data.quickbooks.new_invoice.DueDate').to_time.strftime(\"%-d %b %Y %l:%M%P %Z\") : \"none\") + \"\\n\" +\n\"Amount: \" + _('data.quickbooks.new_invoice.CurrencyRef.value') + \" \" + _('data.quickbooks.new_invoice.TotalAmt').to_s",
     "text": "Hurray! You have a new invoice: #{_('data.quickbooks.new_invoice.Id')}",
