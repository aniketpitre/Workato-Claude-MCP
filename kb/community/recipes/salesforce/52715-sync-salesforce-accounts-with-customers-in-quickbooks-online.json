  "parameters_schema": "[\n  {\n    \"label\": \"Start date\",\n    \"name\": \"start_date\",\n    \"type\": \"date_time\",\n    \"control_type\": \"date_time\",\n    \"hint\": \"Set the date and time from when you want to process records from. by clicking on the calendar icon to the left. (For example: setting it to 12/02/2015 12:00 am will pick up all accounts created or updated since that time.)\"\n  },\n    {\n    \"label\": \"Master for Contacts\",\n    \"name\": \"ContactMaster\",\n    \"type\": \"string\",\n    \"control_type\": \"select\",\n    \"pick_list\": [\n      [\"Salesforce\", \"Salesforce\"],\n      [\"QuickBooks\", \"QuickBooks\"],\n      [\"both\",\"both\"]\n    ],\n    \"hint\": \"Which system is the master for contacts? Salesforce, QuickBooks, or both. Updates will be made to existing QuickBooks customers only if Salesforce is the Master,  otherwise only missing customers will be created in QuickBooks. <br><em>Make sure you use the same value for all your contact sync recipes<em>\"\n  }\n]",
  "param": {},
  "block": [
   {
    "number": 1,
    "provider": "quickbooks",
    "name": "search_customer",
    "as": "lookup_customer1",
    "keyword": "action",
    "dynamicPickListSelection": {},
    "toggleCfg": {},
    "input": {
     "DisplayName": "#{_('data.salesforce.updated_custom_object.Name')}"
    },
    "comment": "Check to see if a corresponding customer exists in Quickbooks",
    "uuid": "d59bb67d-5119-4a7b-8f8d-20b1c9da7876",
    "title": null,
    "description": null
   },
   {
    "number": 2,
    "keyword": "if",
    "dynamicPickListSelection": {},
    "toggleCfg": {},
    "input": {
     "type": "compound",
     "operand": "and",
     "conditions": [
      {
       "lhs": "#{_('data.quickbooks.lookup_customer1.customers.first.DisplayName')}",
       "rhs": null,
       "operand": "blank"
      }
     ]
    },
    "block": [
     {
      "number": 3,
      "provider": "quickbooks",
      "name": "create_customer",
      "as": "create_customer",
      "keyword": "action",
      "dynamicPickListSelection": {
       "SalesTermRef": "Net 30"
      },
      "toggleCfg": {
       "Active": true
      },
      "input": {
       "SalesTermRef": "3",
       "PrimaryPhone_FreeFormNumber": "#{_('data.salesforce.updated_custom_object.Phone')}",
       "DisplayName": "#{_('data.salesforce.updated_custom_object.Name')}",
       "GivenName": "=_('data.salesforce.updated_custom_object.Name').split.first",
       "FamilyName": "=_('data.salesforce.updated_custom_object.Name').split.last",
       "CompanyName": "#{_('data.salesforce.updated_custom_object.Name')}",
       "Mobile_FreeFormNumber": "#{_('data.salesforce.updated_custom_object.Phone')}",
       "WebAddr_URI": "#{_('data.salesforce.updated_custom_object.Website')}",
       "BillAddr_Line1": "#{_('data.salesforce.updated_custom_object.BillingStreet')}",
       "BillAddr_City": "#{_('data.salesforce.updated_custom_object.BillingCity')}",
       "BillAddr_Country": "#{_('data.salesforce.updated_custom_object.BillingCountry')}",
       "BillAddr_PostalCode": "#{_('data.salesforce.updated_custom_object.BillingPostalCode')}",
       "Notes": "#{_('data.salesforce.updated_custom_object.Description')}",
       "BillAddr_CountrySubDivisionCode": "#{_('data.salesforce.updated_custom_object.BillingState')}",
       "ShipAddr_Line1": "#{_('data.salesforce.updated_custom_object.ShippingStreet')}",
       "ShipAddr_City": "#{_('data.salesforce.updated_custom_object.ShippingCity')}",
       "ShipAddr_CountrySubDivisionCode": "#{_('data.salesforce.updated_custom_object.ShippingState')}",
       "ShipAddr_Country": "#{_('data.salesforce.updated_custom_object.ShippingCountry')}",
       "ShipAddr_PostalCode": "#{_('data.salesforce.updated_custom_object.ShippingPostalCode')}",
       "Active": "true"
      },
      "comment": "Create a new customer in Quickbooks",
      "uuid": "f34cdcad-019e-4d63-8c10-5d0c37866a9c",
      "title": null,
      "description": null
     }
    ],
    "comment": "If the customer does not exist in Quickbooks",
    "uuid": "621b8305-8a24-4cb3-8276-c605c9840d6c"
   },
   {
    "number": 4,
    "keyword": "if",
    "dynamicPickListSelection": {},
    "toggleCfg": {},
    "input": {
     "type": "compound",
     "operand": "and",
     "conditions": [
      {
       "lhs": "#{_('data.quickbooks.lookup_customer1.customers.first.DisplayName')}",
       "rhs": null,
       "operand": "present"
      },
      {
       "operand": "equals_to",
       "lhs": "#{_('data.workato.job_context.parameters.ContactMaster')}",
       "rhs": "Salesforce"
      }
     ]
    },
    "block": [
