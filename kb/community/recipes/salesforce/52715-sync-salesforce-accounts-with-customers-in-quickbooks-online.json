{
 "id": 52715,
 "name": "Sync Salesforce accounts with customers in QuickBooks Online",
 "description": "This integration keeps Salesforce accounts in sync with QuickBooks customers.\n\n1. An account is created or updated in Salesforce.\n2. Workato searches for a matching customer in QuickBooks Online.\n3. If the customer already exists in QuickBooks, and Salesforce is the Customer Master, update the QuickBooks customer.\n4. If customer does not already exist in QuickBooks, create the customer.",
 "applications": [
  "salesforce",
  "quickbooks",
  "email"
 ],
 "action_applications": [
  "quickbooks",
  "email"
 ],
 "trigger_application": "salesforce",
 "business_objects": [
