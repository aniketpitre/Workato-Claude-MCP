   "since_offset": "-604800"
  },
  "filter": {
   "conditions": [
    {
     "operand": "present",
     "lhs": "#{_('data.salesforce.new_custom_object.NumberOfEmployees')}",
     "rhs": null
    },
    {
     "operand": "greater_than",
     "lhs": "#{_('data.salesforce.new_custom_object.NumberOfEmployees')}",
     "rhs": "500"
    }
   ],
   "operand": "and",
   "type": "compound"
  },
