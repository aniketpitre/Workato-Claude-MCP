     {
      "number": 4,
      "provider": "slack_bot",
      "name": "post_bot_message",
      "as": "post_bot_message",
      "keyword": "action",
      "dynamicPickListSelection": {},
      "toggleCfg": {
       "channel": true,
       "attachment_buttons.0.bot_command": false
      },
      "input": {
       "channel": "#random",
       "text": "Here you go",
       "message": {
        "title": ":label: Salesforce Product: #{_('data.salesforce.get_custom_object.Name')}",
        "title_link": "https://ap2.salesforce.com/#{_('data.salesforce.get_custom_object.Id')}",
        "color": "good"
       },
       "attachment_fields": [
        {
         "title": ":dollar: Price",
         "value": "$#{_('data.salesforce.get_related.PricebookEntries.first.UnitPrice')}"
        },
        {
         "title": ":id: Code",
         "value": "#{_('data.salesforce.get_custom_object.ProductCode')}"
        },
        {
         "title": "Description",
         "value": "#{_('data.salesforce.get_custom_object.Description')}"
        },
        {
         "title": "=(_('data.salesforce.get_custom_object.IsActive')? \":white_check_mark:\" : \":x:\") + \" Status\"",
         "value": "=_('data.salesforce.get_custom_object.IsActive')? \"Active\" : \"Not Active\""
        }
       ],
       "attachment_buttons": [
        {
         "title": "=(_('data.salesforce.get_custom_object.IsActive') ? \"De-activate\" : \"Activate\")",
         "bot_command": "update_by_product_activity salesforce product",
         "params": "=\"product_id: _('data.slack_bot.bot_document_mention.object_id') product_activity: \" + (_('data.salesforce.get_custom_object.IsActive') ? \"false\" : \"true\")"
        }
       ]
      },
