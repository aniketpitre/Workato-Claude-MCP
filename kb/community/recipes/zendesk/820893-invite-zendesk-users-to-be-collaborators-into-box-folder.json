{
 "id": 820893,
 "name": "Invite Zendesk users to be collaborators into Box folder",
 "description": "1. A new user is created in Zendesk.\n2. Workato searches for a folder in Box that matches the new user's **organization name**.\n3. If no matching folder is found in Box, Workato creates a new folder in Box.\n4. Workato invites the new Zendesk user to be an **Editor** of the Box folder.",
 "applications": [
  "zendesk",
