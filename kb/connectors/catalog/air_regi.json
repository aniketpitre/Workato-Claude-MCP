{
 "name": "air_regi",
 "title": "AirREGI",
 "requires_connection": true,
 "categories": [
  "Payment Processing/POS"
 ],
 "aliases": [
  "AirREGI"
 ],
 "triggers": [
  {
   "name": "new_refund",
   "title": "New refund",
   "description": "New refund in AirREGI",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "hint": "Get refunds created since the given date/time. Leave empty to get refunds created 1 hour ago. Once recipe has been run or tested, value cannot be changed. Learn more"
    }
   ],
   "output": [
    {
     "name": "id",
     "type": "string",
     "label": "ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "storeId",
     "type": "string",
     "label": "Store ID",
     "control_type": "text",
     "required": true
    },
    {
