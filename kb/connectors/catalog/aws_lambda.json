  {
   "name": "invoke_function",
   "title": "Invoke function",
   "description": "Invoke function in AWS Lambda",
   "input": [
    {
     "name": "FunctionName",
     "type": "string",
     "label": "Function name",
     "control_type": "select",
     "required": true,
     "pick_list": "functions",
     "extends_schema": true,
     "toggle_field": {
      "name": "FunctionName",
      "type": "string"
     },
     "hint": "Only the first 50 functions are displayed in the list. If you do not find your function in the list, toggle to use full function name."
    },
    {
     "name": "list_item",
     "type": "object",
     "label": "Function input",
     "control_type": "form-schema-builder",
     "extends_schema": true,
     "properties": [
