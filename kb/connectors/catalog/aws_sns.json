{
 "name": "aws_sns",
 "title": "Amazon SNS",
 "requires_connection": true,
 "categories": [
  "Developer Tool"
 ],
 "aliases": [
  "Amazon SNS",
  "sns"
 ],
 "triggers": [
  {
   "name": "new_message",
   "title": "New message from a topic",
   "description": "New message from a topic in Amazon SNS",
   "help": "Triggers as soon as a message is published to the selected topic. Note: FIFO topics are not supported in the Amazon SNS trigger. As FIFO topics feed data to SQS queues, please use our Amazon SQS connector to receive these events.",
   "input": [
    {
     "name": "topic_arn",
     "type": "string",
     "label": "Topic name",
     "control_type": "select",
     "required": true,
     "pick_list": "topic_arn_list",
     "extends_schema": true,
     "toggle_field": {
      "name": "topic_arn",
      "type": "string"
     }
    },
    {
     "name": "message_format",
     "type": "string",
     "label": "Message format",
     "control_type": "select",
     "required": true,
     "default": "json",
     "options": [
      "raw",
      "json"
     ],
     "extends_schema": true
    }
   ],
   "output": [
    {
     "name": "type",
     "type": "string",
     "label": "Type",
     "control_type": "text",
     "required": true
    },
    {
     "name": "message_id",
     "type": "string",
     "label": "Message ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "topic_arn",
     "type": "string",
     "label": "Topic ARN",
     "control_type": "text",
     "required": true
    },
    {
     "name": "topic_name",
     "type": "string",
     "label": "Topic name",
     "control_type": "text",
     "required": true
    },
    {
     "name": "subject",
     "type": "string",
     "label": "Subject",
     "control_type": "text",
     "required": true
    },
    {
     "name": "timestamp",
     "type": "string",
     "label": "Timestamp",
     "control_type": "text",
     "required": true
    },
    {
     "name": "signature_version",
     "type": "string",
     "label": "Signature version",
     "control_type": "text",
     "required": true
    },
    {
     "name": "signature",
     "type": "string",
     "label": "Signature",
     "control_type": "text",
     "required": true
    },
    {
     "name": "signing_cert_url",
     "type": "string",
     "label": "Signing cert URL",
     "control_type": "text",
     "required": true
    },
    {
     "name": "unsubscribe_url",
     "type": "string",
     "label": "Unsubscribe URL",
     "control_type": "text",
     "required": true
    }
   ]
  }
 ],
 "actions": [
  {
   "name": "publish_to_topic",
   "title": "Publish message to topic",
   "description": "Publish message to a topic in Amazon SNS",
   "input": [
    {
     "name": "topic_arn",
     "type": "string",
     "label": "Topic Name",
     "control_type": "select",
     "pick_list": "topic_arn_list",
     "extends_schema": true,
     "toggle_field": {
      "name": "topic_name",
      "type": "string"
     }
    },
    {
     "name": "topic_type",
     "type": "string",
     "label": "Topic type",
     "control_type": "select",
     "required_when_visible": true,
     "default": "Standard",
     "options": [
      "FIFO",
      "Standard"
     ],
     "extends_schema": true,
     "toggle_field": {
      "name": "topic_type",
      "type": "string"
     },
     "hint": "Possible values are: FIFO, Standard . Default: Standard ."
    },
    {
     "name": "subject",
     "type": "string",
     "label": "Subject",
     "control_type": "text",
     "required": true
    },
    {
     "name": "message_format",
     "type": "string",
     "label": "Message Format",
     "control_type": "select",
     "required": true,
     "default": "json",
     "options": [
      "raw",
      "json"
     ],
     "extends_schema": true
    }
   ],
   "output": [
    {
     "name": "message_id",
     "type": "string",
     "label": "Message ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "sequence_number",
     "type": "string",
     "label": "Sequence number",
     "control_type": "text",
     "required": true
    }
   ]
  }
 ]
}
