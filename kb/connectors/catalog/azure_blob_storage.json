   "name": "download_blob",
   "title": "Download blob contents",
   "description": "Download​ contents ​from a blob ​in Azure Blob Storage",
   "help": "This action downloads a blob’s content. This action is streaming compatible through chunking. Default chunk is 10MB",
   "input": [
    {
     "name": "container",
     "type": "string",
     "label": "Container name",
     "control_type": "select",
     "required": true,
     "pick_list": "listContainers",
     "extends_schema": true,
     "toggle_field": {
      "name": "container",
      "type": "string"
     },
     "hint": "Select the container which contains the blob. Returns the first 200 containers. If your container cannot be found or is a datapill, toggle to text input and enter the container name."
    },
    {
     "name": "blob",
     "type": "string",
     "label": "Blob name",
     "control_type": "select",
     "required": true,
     "pick_list": "listBlobs",
     "extends_schema": true,
     "toggle_field": {
      "name": "blob",
      "type": "string"
     },
     "hint": "Select the blob to be processed. Returns the first 5000 blobs. If your blob cannot be found or is a datapill, toggle to text input and enter the blob name."
    },
    {
     "name": "chunk_size",
     "type": "string",
     "label": "Chunk size",
     "control_type": "text",
     "default": "10MB",
     "hint": "File contents will be transferred in chunks of this size. Enter the size with the unit, Eg. 50KB. Valid units are 'B', 'KB', 'MB'. Default chunk size is 10MB . Minimum is 32KB and maximum is 10MB . Us…"
    },
    {
     "name": "encoding",
     "type": "string",
     "label": "Encoding of the file content",
     "control_type": "select",
     "pick_list": "supported_encodings_with_binary_global_pick_list",
     "extends_schema": true,
     "toggle_field": {
      "name": "encoding",
      "type": "string"
     },
     "hint": "Specify the encoding of the file to set it explicitly. By default, encoding will be set to UTF-8 if left blank. Click here to know more about the different encodings supported."
    }
   ],
   "output": [
    {
     "name": "blob_content",
     "type": "string",
     "label": "Blob contents",
     "control_type": "text",
     "required": true
    },
    {
