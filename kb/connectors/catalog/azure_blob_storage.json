  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Azure Blob Storage (Custom)",
   "help": "Build your own Azure Blob Storage action with a HTTP request. The request will be authorized under your chosen Azure Blob Storage connection OAuth scopes.",
