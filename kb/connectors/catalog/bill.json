    {
     "name": "object",
     "type": "string",
     "label": "Object",
     "control_type": "select",
     "required": true,
     "pick_list": "search_object",
     "extends_schema": true,
     "hint": "Select the object from picklist."
    },
    {
     "name": "since",
     "type": "date_time",
