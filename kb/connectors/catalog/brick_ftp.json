{
 "name": "brick_ftp",
 "title": "BrickFTP",
 "requires_connection": true,
 "categories": [
  "File Transfer"
 ],
 "aliases": [
  "BrickFTP",
  "sftp"
 ],
 "triggers": [
  {
   "name": "new_file",
   "title": "New file",
   "description": "New file in BrickFTP",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "folder",
     "type": "string",
     "label": "Folder",
     "control_type": "select",
     "pick_list": "folder_list"
    }
   ],
   "output": [
    {
     "name": "path",
     "type": "string",
     "label": "Path",
     "control_type": "text",
     "required": true
    },
    {
     "name": "size",
     "type": "integer",
     "label": "Size",
     "control_type": "text",
     "required": true
    },
    {
     "name": "mtime",
     "type": "date_time",
     "label": "Mtime",
     "control_type": "text",
     "required": true
    },
    {
     "name": "crc32",
     "type": "string",
     "label": "CRC32",
     "control_type": "text",
     "required": true
    },
    {
     "name": "md5",
     "type": "string",
     "label": "MD5",
     "control_type": "text",
     "required": true
    },
    {
     "name": "download_uri",
     "type": "string",
     "label": "Download URI",
     "control_type": "url",
     "required": true
    }
   ]
  }
 ],
 "actions": []
}
