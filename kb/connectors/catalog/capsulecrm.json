 "triggers": [
  {
   "name": "new_opportunity",
   "title": "New opportunity",
   "description": "New opportunity in Capsule CRM",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    }
   ],
   "output": [
    {
     "name": "name",
     "type": "string",
     "label": "Name",
     "control_type": "text",
     "required": true,
     "hint": "Opportunity name"
    },
    {
     "name": "description",
     "type": "string",
     "label": "Description",
     "control_type": "text-area"
    },
    {
     "name": "milestone",
     "type": "string",
     "label": "Milestone",
     "control_type": "select",
     "required": true,
     "pick_list": "list_milestones",
     "toggle_field": {
      "name": "milestone",
      "type": "string"
     },
     "hint": "Milestone of opportunity"
    },
    {
     "name": "currency",
     "type": "string",
     "label": "Currency",
     "control_type": "text",
     "required": true,
     "hint": "Currency ISO code"
    },
    {
     "name": "value",
     "type": "string",
     "label": "Value",
     "control_type": "text",
     "required": true,
     "hint": "Opportunity value"
    },
    {
     "name": "durationBasis",
     "type": "string",
     "label": "Duration basis",
     "control_type": "select",
     "options": [
      "FIXED",
      "HOUR",
      "DAY",
      "WEEK",
      "MONTH",
      "QUARTER",
      "YEAR"
     ],
     "toggle_field": {
      "name": "durationBasis",
      "type": "string"
     },
     "hint": "Fixed for occasional occurrence, choose a period whereby opportunity occurs otherwise"
    },
    {
     "name": "duration",
     "type": "integer",
     "label": "Duration",
     "control_type": "text",
     "hint": "Required if duration basis is not Fixed. Input number of times opportunity repeats."
    },
    {
     "name": "expectedCloseDate",
     "type": "date_time",
     "label": "Expected close date",
     "control_type": "date_time"
    },
    {
     "name": "actualCloseDate",
     "type": "date_time",
     "label": "Actual close date",
     "control_type": "date_time",
     "hint": "Defaults to system date if milestone selected closes opportunity"
    },
    {
     "name": "owner",
     "type": "string",
     "label": "Owner",
     "control_type": "text"
    },
    {
     "name": "createdOn",
     "type": "date_time",
     "label": "Date created",
     "control_type": "date_time",
     "required": true
    },
    {
     "name": "updatedOn",
     "type": "date_time",
     "label": "Date updated",
     "control_type": "date_time",
     "required": true
    }
   ]
  },
