         "label": "Request ID",
         "control_type": "text"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "name": "set_alarm_state",
   "title": "Set alarm state",
   "description": "Set alarm state in Cloud Watch",
   "input": [
    {
     "name": "AlarmName",
     "type": "string",
     "label": "Alarm name",
     "control_type": "text",
