  {
   "name": "disable_alarm",
   "title": "Disable alarm",
   "description": "Disable alarm in Cloud Watch",
   "input": [
    {
     "name": "alarm_names",
     "type": "array",
     "label": "Alarm names",
     "required": true,
     "of": "object",
     "properties": [
      {
       "name": "alarm_name",
       "type": "string",
       "label": "Alarm name",
       "control_type": "text",
       "required": true
      }
     ]
    }
   ],
   "output": [
    {
     "name": "DisableAlarmActionsResponse",
     "type": "object",
     "label": "Disable alarm actions response",
