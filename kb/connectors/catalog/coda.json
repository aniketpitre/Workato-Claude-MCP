 "actions": [
  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Coda (Custom)",
   "help": "Build your own Coda action with a HTTP request. The request will be authorized with your Coda connection.",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
  {
   "name": "create_export",
   "title": "Begin page content export",
   "description": "Begin a page content export in a Coda doc",
   "help": "Starts an asynchronous export for a page. Use the returned export ID with the Get content export status action to poll for completion and retrieve the download link.",
   "input": [
    {
     "name": "docId",
     "type": "string",
     "label": "Doc ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "pageId",
     "type": "string",
     "label": "Page ID or name",
     "control_type": "text",
     "required": true,
     "hint": "The ID or name of the page to export."
    },
    {
     "name": "type",
     "type": "string",
     "label": "Export type",
     "control_type": "select",
     "required": true,
     "hint": "The type of export to perform. Example: html, markdown"
    }
   ],
   "output": [
    {
     "name": "id",
     "type": "string",
     "label": "Export ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "status",
     "type": "string",
     "label": "Status",
     "control_type": "text",
     "required": true
    },
    {
     "name": "href",
     "type": "string",
     "label": "Href",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "get_content_export_status",
   "title": "Get content export status",
   "description": "Get content export status for a Coda page",
   "help": "Polls the status of an export job started with Begin page content export . When completed, the response contains a download link.",
   "input": [
    {
     "name": "docId",
     "type": "string",
     "label": "Doc ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "pageId",
     "type": "string",
     "label": "Page ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "exportId",
     "type": "string",
     "label": "Export ID",
     "control_type": "text",
     "required": true
    }
   ],
   "output": [
    {
     "name": "id",
     "type": "string",
     "label": "Export ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "status",
     "type": "string",
     "label": "Status",
     "control_type": "text",
     "required": true
    },
    {
     "name": "href",
     "type": "string",
     "label": "Href",
     "control_type": "text",
     "required": true
    },
    {
     "name": "downloadLink",
     "type": "string",
     "label": "Download link",
     "control_type": "text",
     "required": true
    },
    {
     "name": "error",
     "type": "string",
     "label": "Error",
     "control_type": "text",
     "required": true
