{
 "name": "cxml",
 "title": "cXML",
 "requires_connection": true,
 "categories": [
  "Developer Tool"
 ],
 "aliases": [
  "cXML"
 ],
 "triggers": [
  {
   "name": "new_purchase_order",
   "title": "New purchase order",
   "description": "New purchase order in cXML gateway",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    }
   ],
   "output": []
  }
 ],
 "actions": [
  {
   "name": "new_invoice",
   "title": "Create new invoice",
   "description": "Create new invoice in cXML gateway",
   "input": [
    {
     "name": "taxableAmount",
     "type": "integer",
     "label": "Taxable amount",
     "control_type": "text",
     "required": true
    },
    {
     "name": "taxPercentageRate",
     "type": "integer",
     "label": "Tax percentage rate",
     "control_type": "text",
     "required": true
    },
    {
     "name": "taxAmount",
     "type": "integer",
     "label": "Tax amount",
     "control_type": "text"
    },
    {
     "name": "specialHandlingAmount",
     "type": "integer",
     "label": "Special handling amount",
     "control_type": "text"
    },
    {
     "name": "shippingAmount",
     "type": "integer",
     "label": "Shipping amount",
     "control_type": "text"
    },
    {
     "name": "netAmount",
     "type": "integer",
     "label": "Net amount",
     "control_type": "text"
    },
    {
     "name": "items",
     "type": "array",
     "label": "Items",
     "of": "object",
     "properties": [
      {
       "name": "lineNumber",
       "type": "integer",
       "label": "Line number",
       "control_type": "text"
      },
      {
       "name": "quantity",
       "type": "integer",
       "label": "Quantity",
       "control_type": "text"
      },
      {
       "name": "unitOfMeasure",
       "type": "string",
       "label": "Unit of measure",
       "control_type": "text"
      },
      {
       "name": "unitPrice",
       "type": "integer",
       "label": "Unit price",
       "control_type": "text"
      },
      {
       "name": "subTotal",
       "type": "integer",
       "label": "Sub total",
       "control_type": "text"
      }
     ]
    }
   ],
   "output": []
  }
 ]
}
