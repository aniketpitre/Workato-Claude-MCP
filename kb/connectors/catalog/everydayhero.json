 "triggers": [
  {
   "name": "new_page",
   "title": "New page",
   "description": "New page created in everydayhero",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "type",
     "type": "string",
     "label": "Type",
     "control_type": "text",
     "hint": "Supported values include all, individual and team. Defaults to all."
    },
    {
     "name": "since_offset",
     "type": "string",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "select",
     "required": true,
     "default": -3600,
     "options": [
      0,
      -3600,
      -86400,
      -604800,
      -2629746,
      "no_limit"
     ],
     "toggle_field": {
      "name": "since",
      "type": "date_time"
     },
     "hint": "Process trigger events since this date/time. Once recipe has been run or tested, value cannot be changed. Learn more"
    }
   ],
