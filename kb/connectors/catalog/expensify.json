{
 "name": "expensify",
 "title": "Expensify",
 "requires_connection": true,
 "categories": [
  "Time and Expense"
 ],
 "aliases": [
  "Expensify"
 ],
 "triggers": [
  {
   "name": "expense_report_created",
   "title": "Expense report created",
   "description": "Expense report created in Expensify",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date",
     "hint": "Expense report created since the given date. Leave empty to return reports created 1 day ago. Once recipe has been run or tested, value cannot be changed. Learn more"
    },
    {
     "name": "reportState",
     "type": "string",
