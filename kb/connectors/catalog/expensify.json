 "actions": [
  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Expensify (Custom)",
   "help": "Build your own Expensify action with a HTTP request. The request will be authorized with your Expensify connection. API supports only POST request type. Specify all the input values except credentials in Request body parameters as mentioned in API documentation.",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "extends_schema": true,
     "hint": "Give this action a descriptive name. First word is expected to be a verb."
    }
   ],
   "output": []
  },
  {
   "name": "create_expense",
   "title": "Create expense",
   "description": "Create expense in Expensify",
   "input": [
    {
     "name": "merchant",
     "type": "string",
     "label": "Merchant",
     "control_type": "text",
     "required": true,
     "hint": "Name of the merchant of the expense"
    },
    {
     "name": "employeeEmail",
     "type": "string",
     "label": "Employee email",
     "control_type": "text",
     "required": true,
     "hint": "Email of the integration admin"
    },
    {
     "name": "amount",
     "type": "number",
     "label": "Amount",
     "control_type": "number",
     "required": true
    },
    {
     "name": "currency",
     "type": "string",
     "label": "Currency code",
     "control_type": "text",
     "required": true,
     "toggle_field": {
      "name": "currency",
      "type": "string"
     },
     "hint": "A three letter string representing the ISO 4217 code for the currency. For example, USD, AUD, EUR,.."
    },
    {
     "name": "externalID",
     "type": "string",
     "label": "External ID",
     "control_type": "text",
     "hint": "A unique, custom string that you specify to help identify the expense after being exported"
    },
    {
     "name": "created",
     "type": "date_time",
     "label": "Created",
     "control_type": "date",
     "required": true,
     "hint": "Date of the expense"
    }
   ],
   "output": [
    {
     "name": "merchant",
     "type": "string",
     "label": "Merchant",
     "control_type": "text",
     "required": true
    },
    {
     "name": "currency",
     "type": "string",
     "label": "Currency",
     "control_type": "text",
     "required": true
    },
    {
     "name": "amount",
     "type": "number",
     "label": "Amount",
     "control_type": "number",
     "required": true
    },
    {
     "name": "created",
     "type": "string",
     "label": "Created",
     "control_type": "date",
     "required": true
    },
    {
     "name": "transactionID",
     "type": "string",
     "label": "Transaction ID",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "create_report",
   "title": "Create expense report",
   "description": "Create expense report in Expensify",
   "input": [
    {
     "name": "employeeEmail",
     "type": "string",
     "label": "Employee email",
     "control_type": "text",
     "required": true
    },
    {
     "name": "policyID",
     "type": "string",
     "label": "Policy ID",
     "control_type": "text",
     "required": true,
     "hint": "The report will be created in this policy"
    },
    {
     "name": "title",
     "type": "string",
     "label": "Title",
     "control_type": "text",
     "required": true,
     "hint": "Title of the report"
    },
    {
     "name": "merchant",
     "type": "string",
     "label": "Merchant",
     "control_type": "text",
     "required": true,
     "hint": "Name of the merchant of the expense"
    },
    {
     "name": "amount",
     "type": "number",
     "label": "Amount",
     "control_type": "number",
     "required": true,
     "hint": "Amount of the transaction"
    },
    {
     "name": "currency",
     "type": "string",
     "label": "Currency code",
     "control_type": "text",
     "required": true,
     "toggle_field": {
      "name": "currency",
      "type": "string"
     },
     "hint": "A three letter string representing the ISO 4217 code for the currency. For example, USD, AUD, EUR,.."
    },
    {
     "name": "date",
     "type": "date_time",
     "label": "Date",
     "control_type": "date",
     "required": true,
     "hint": "Date the expense was made"
    }
   ],
   "output": [
    {
     "name": "reportName",
     "type": "string",
     "label": "Report name",
     "control_type": "text",
     "required": true
    },
    {
     "name": "reportID",
     "type": "string",
     "label": "Report ID",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "export_reports",
   "title": "Export reports",
   "description": "Export reports from Expensify using a custom template",
   "help": "Generate a report file formatted with your FreeMarker template, then download its content. The file content can be passed to downstream file actions.",
   "input": [
    {
     "name": "template",
     "type": "string",
     "label": "Template",
     "control_type": "code",
     "required": true,
     "hint": "FreeMarker template used to format the exported data. See the export template reference ."
    },
    {
     "name": "reportState",
     "type": "string",
     "label": "Report state",
     "control_type": "multiselect",
     "options": [
      "OPEN",
      "SUBMITTED",
      "APPROVED",
      "REIMBURSED",
      "ARCHIVED"
     ],
     "toggle_field": {
      "name": "reportState",
      "type": "string"
     },
     "hint": "Only reports in the selected state(s) are exported. Select multiple states to export any of them. Leave empty to export all states."
    },
    {
     "name": "startDate",
     "type": "date",
     "label": "Start date",
     "control_type": "date",
     "hint": "Export reports submitted or created on/after this date."
    },
    {
     "name": "endDate",
     "type": "date",
     "label": "End date",
     "control_type": "date",
     "hint": "Export reports submitted or created on/before this date. The date range cannot exceed one year."
    },
    {
     "name": "approvedAfter",
     "type": "date",
     "label": "Approved after",
     "control_type": "date",
     "hint": "Export only reports approved on/after this date."
    },
    {
     "name": "reportIDList",
     "type": "string",
     "label": "Report ID list",
     "control_type": "text",
     "hint": "Comma-separated list of report IDs to export."
    },
    {
     "name": "policyIDList",
     "type": "string",
     "label": "Policy ID list",
     "control_type": "text",
     "hint": "Comma-separated list of policy IDs the exported reports must belong to."
    },
    {
     "name": "limit",
     "type": "integer",
     "label": "Limit",
     "control_type": "integer",
     "hint": "Maximum number of reports to export."
    },
    {
     "name": "markedAsExported",
     "type": "string",
     "label": "Marked as exported",
     "control_type": "text",
     "hint": "Skip reports already exported with this label."
    },
    {
     "name": "fileExtension",
     "type": "string",
     "label": "File extension",
     "control_type": "select",
     "default": "csv",
     "options": [
      "csv",
      "xls",
      "xlsx",
      "txt",
      "pdf",
      "json",
      "xml"
     ],
     "hint": "Determines the generated file's name and MIME type only. The file's actual content is defined entirely by your template, so write the template to match the format you select here (e.g. write valid JSO…"
    },
    {
     "name": "fileBasename",
     "type": "string",
     "label": "File basename",
     "control_type": "text",
     "hint": "The generated file name starts with this value. Defaults to export ."
    },
    {
     "name": "emailOnFinish",
     "type": "object",
     "label": "Email on finish",
     "properties": [
      {
       "name": "recipients",
       "type": "string",
       "label": "Recipients",
       "control_type": "text",
       "hint": "Comma-separated email addresses to notify. Required to send the email."
      },
      {
       "name": "message",
       "type": "string",
       "label": "Message",
       "control_type": "text-area",
       "hint": "Email message content. FreeMarker syntax is supported; use the `filenames` list to reference generated file names."
      }
     ],
     "hint": "Expensify emails a link to the generated file once the export completes."
    },
    {
     "name": "markAsExportedLabel",
     "type": "string",
     "label": "Mark as exported with label",
     "control_type": "text",
     "hint": "Expensify marks the exported reports with this label once the export completes. Use the same value in Marked as exported to skip these reports in later exports."
    }
   ],
   "output": [
    {
     "name": "fileName",
     "type": "string",
     "label": "File name",
     "control_type": "text",
     "required": true
    },
    {
     "name": "content",
     "type": "string",
     "label": "File content",
     "control_type": "text-area",
     "required": true
    },
    {
     "name": "size",
     "type": "integer",
     "label": "File size (bytes)",
     "control_type": "number",
     "required": true
    }
   ]
  },
