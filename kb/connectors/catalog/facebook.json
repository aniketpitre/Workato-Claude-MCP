   "title": "Custom action",
   "description": "Custom action in Facebook (Custom)",
   "help": "Build your own Facebook action with a HTTP request. The request will be authorized under your Facebook connection OAuth scopes: Scopes ads_management, ads_read, read_insights, pages_read_engagement, pages_manage_posts",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
