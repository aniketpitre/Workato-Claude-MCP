{
 "name": "feedly",
 "title": "Feedly",
 "requires_connection": true,
 "categories": [
  "Document/File"
 ],
 "aliases": [
  "Feedly"
 ],
 "triggers": [
  {
   "name": "new_item",
   "title": "New item",
   "description": "New item on Feedly",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "filter",
     "type": "string",
     "label": "Filter",
     "control_type": "select",
     "required": true,
     "options": [
      "categories",
      "tags",
      "feeds",
      "saved"
     ],
     "extends_schema": true,
     "hint": "Select the type of new item"
    }
   ],
   "output": [
    {
     "name": "id",
     "type": "string",
     "label": "ID",
     "control_type": "text",
     "required": true
    },
    {
