  "Document"
 ],
 "aliases": [
  "Google Slides"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Google Slides (Custom)",
   "help": "Build your own Google Slides action with a HTTP request. The request will be authorized with your Google Slides connection.",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
  {
   "name": "add_record",
   "title": "Add record",
   "description": "Add record in Google Slides",
   "input": [
    {
     "name": "record_type",
     "type": "string",
     "label": "Record type",
     "control_type": "select",
     "required": true,
     "pick_list": "add_record_types",
     "extends_schema": true
    }
   ],
   "output": []
  },
  {
   "name": "copy_slide",
   "title": "Copy slide",
   "description": "Copy a slide in Google Slides",
   "input": [
    {
     "name": "presentation_id",
     "type": "string",
     "label": "Presentation ID",
     "control_type": "text",
     "required": true,
     "hint": "The presentation ID or full Google Slides URL."
    },
    {
     "name": "source_slide_number",
     "type": "integer",
     "label": "Source slide number",
     "control_type": "integer",
     "required": true,
     "hint": "The slide number to copy (1-indexed)."
    },
    {
     "name": "position",
     "type": "integer",
     "label": "Position",
     "control_type": "integer",
     "hint": "Position to place the copy (1-indexed). Placed after source if not specified."
    }
   ],
   "output": [
    {
     "name": "copied_slide_object_id",
     "type": "string",
     "label": "Copied slide object ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "position",
     "type": "integer",
     "label": "Position",
     "control_type": "text",
     "required": true
