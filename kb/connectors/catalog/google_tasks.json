  {
   "name": "move_task",
   "title": "Move task",
   "description": "Move task in Google Tasks",
   "help": "Moves a task to a different position or task list.",
   "input": [
    {
     "name": "list_id",
     "type": "string",
     "label": "Task list",
     "control_type": "select",
     "required": true,
     "pick_list": "tasklists",
     "toggle_field": {
      "name": "list_id",
      "type": "string"
     }
    },
    {
     "name": "task_id",
     "type": "string",
     "label": "Task ID",
     "control_type": "text",
     "required": true,
     "hint": "The Google Tasks task ID."
    },
    {
     "name": "parent_mode",
     "type": "string",
     "label": "Parent mode",
     "control_type": "select",
     "required": true,
     "options": [
      "keep",
      "top_level",
      "under_task"
     ],
     "toggle_field": {
      "name": "parent_mode",
      "type": "string"
     },
     "hint": "Choose how to place the task in the parent hierarchy. Set to Under task to require Parent task ID."
    },
    {
     "name": "parent_task_id",
     "type": "string",
     "label": "Parent task ID",
     "control_type": "text",
     "hint": "Required when Parent mode is set to Under task."
    },
    {
     "name": "position_mode",
     "type": "string",
     "label": "Position mode",
     "control_type": "select",
     "required": true,
     "options": [
      "keep",
      "first",
      "after_task"
     ],
     "toggle_field": {
      "name": "position_mode",
      "type": "string"
     },
     "hint": "Choose where to place the task among siblings. Set to After task to require Previous task ID."
    },
    {
     "name": "previous_task_id",
     "type": "string",
