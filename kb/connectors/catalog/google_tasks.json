{
 "name": "google_tasks",
 "title": "Google Tasks",
 "requires_connection": true,
 "categories": [
  "Productivity"
 ],
 "aliases": [
  "Google Tasks"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Google Tasks (Custom)",
   "help": "Build your own Google Tasks action with a HTTP request. The request will be authorized with your Google Tasks connection.",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
  {
   "name": "create_task",
   "title": "Create task",
   "description": "Create task in Google Tasks",
   "help": "Creates a task in the specified task list.",
   "input": [
    {
     "name": "list_id",
     "type": "string",
     "label": "Task list",
     "control_type": "select",
     "pick_list": "tasklists",
     "toggle_field": {
      "name": "list_id",
      "type": "string"
     },
     "hint": "Defaults to @default when omitted."
    },
    {
