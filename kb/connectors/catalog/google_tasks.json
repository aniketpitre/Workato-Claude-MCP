     "hint": "Defaults to @default when omitted."
    },
    {
     "name": "include_completed",
     "type": "boolean",
     "label": "Include completed",
     "control_type": "checkbox",
     "toggle_field": {
      "name": "include_completed",
      "type": "boolean"
     },
     "hint": "Defaults to No when omitted. Set to Yes to include both active and completed tasks. To include completed tasks hidden after clear-completed in Google Tasks, also set Show hidden to Yes."
    },
    {
     "name": "due_state",
     "type": "string",
     "label": "Due state",
     "control_type": "select",
     "options": [
      "any",
