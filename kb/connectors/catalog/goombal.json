{
 "name": "goombal",
 "title": "Goombal",
 "requires_connection": true,
 "categories": [
  "Marketing",
  "Event management"
 ],
 "aliases": [
  "Goombal"
 ],
 "triggers": [
  {
   "name": "updated_attendee",
   "title": "Updated attendee",
   "description": "Updated attendee in Goombal",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "campaign",
     "type": "string",
     "label": "Campaign",
     "control_type": "text",
     "required": true
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "hint": "Defaults to 1 week before recipe start Once recipe has been run or tested, value cannot be changed. Learn more"
    }
   ],
   "output": [
    {
     "name": "email",
     "type": "string",
     "label": "Email",
     "control_type": "email"
    },
    {
     "name": "firstName",
     "type": "string",
     "label": "First name",
     "control_type": "text"
    },
    {
     "name": "lastName",
     "type": "string",
     "label": "Last name",
     "control_type": "text"
    },
    {
     "name": "address",
     "type": "string",
     "label": "Address",
     "control_type": "text-area"
    },
    {
     "name": "workPhone",
     "type": "string",
     "label": "Work phone",
     "control_type": "phone"
    },
    {
     "name": "mobilePhone",
     "type": "string",
     "label": "Mobile phone",
     "control_type": "phone"
    },
    {
     "name": "company",
     "type": "string",
     "label": "Company",
     "control_type": "text"
    },
    {
     "name": "TotalGuest",
     "type": "integer",
     "label": "Number of guests",
     "control_type": "text"
    },
    {
     "name": "comments",
     "type": "string",
     "label": "Comments",
     "control_type": "text-area"
    },
    {
     "name": "status",
     "type": "string",
     "label": "Status",
     "control_type": "select",
     "options": [
      "Registered",
      "No Response",
      "Rejected",
      "Attended",
      "No Show",
      "Left Early",
      "Canceled",
      "Hot Lead",
      "Warm Lead",
      "Lead"
     ],
     "toggle_field": {
      "name": "status",
      "type": "string"
     },
     "hint": "Defaults to null if left empty"
    },
    {
     "name": "registeredDate",
     "type": "string",
     "label": "Registered date",
     "control_type": "date_time"
    },
    {
     "name": "regType",
     "type": "string",
     "label": "Registration type",
     "control_type": "text"
    },
    {
     "name": "amtPaid",
     "type": "number",
     "label": "Amount paid",
     "control_type": "text"
    },
    {
     "name": "statusName",
     "type": "string",
     "label": "Status name",
     "control_type": "text",
     "required": true
    },
    {
     "name": "attendeeId",
     "type": "string",
     "label": "Attendee ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "updatedDateTime",
     "type": "date_time",
     "label": "Updated date time",
     "control_type": "date_time",
     "required": true
    }
   ]
  }
 ],
