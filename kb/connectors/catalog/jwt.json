{
 "name": "jwt",
 "title": "JWT tools by Workato",
 "requires_connection": true,
 "categories": [
  "Security",
  "Utilities",
  "Workato"
 ],
 "aliases": [
  "JWT tools by Workato",
  "utility",
  "utilities"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "decode",
   "title": "Decode JWT",
   "description": "Decode JSON web token",
   "help": "Use this action to decode JSON web token. Validates iat, exp, and nbf when present. The action raises exception when the token is invalid.",
   "input": [
    {
     "name": "jwt",
     "type": "string",
     "label": "JSON web token",
     "control_type": "text",
     "required": true
    },
    {
     "name": "exp_leeway",
     "type": "integer",
     "label": "Exp leeway",
     "control_type": "number",
     "default": "30",
     "hint": "Expiry leeway in seconds"
    }
   ],
   "output": [
    {
     "name": "payload",
     "type": "object",
     "label": "Payload",
     "required": true,
     "properties": [
      {
       "name": "sub",
       "type": "string",
       "label": "Subject(sub)",
       "control_type": "text"
      },
      {
       "name": "iat",
       "type": "date_time",
       "label": "Issued At(iat)",
       "control_type": "date_time"
      },
      {
       "name": "exp",
       "type": "date_time",
       "label": "Expiration Time(exp)",
       "control_type": "date_time"
      },
      {
       "name": "nbf",
       "type": "date_time",
       "label": "Not before Time(nbf)",
       "control_type": "date_time"
      },
      {
       "name": "iss",
       "type": "string",
       "label": "Issuer(iss)",
       "control_type": "text"
      },
      {
       "name": "aud",
       "type": "string",
       "label": "Audience(aud)",
       "control_type": "text"
      },
      {
       "name": "jti",
       "type": "string",
       "label": "JWT ID(jti)",
       "control_type": "text"
      },
      {
       "name": "scope",
       "type": "string",
       "label": "Scopes",
       "control_type": "text",
       "hint": "Space-separated list of scopes associated with the token as outlined in Section 3.3 of RFC6749 ."
      }
     ]
    },
    {
     "name": "header",
     "type": "object",
     "label": "Header",
     "properties": [
      {
       "name": "typ",
       "type": "string",
       "label": "Key ID(sub)",
       "control_type": "text",
       "required": true
      },
      {
       "name": "alg",
       "type": "string",
       "label": "Algorithm",
       "control_type": "text",
       "required": true
      },
      {
       "name": "kid",
       "type": "string",
       "label": "Key ID(sub)",
       "control_type": "text",
       "required": true
      }
     ]
    }
   ]
  },
  {
   "name": "encode",
   "title": "Generate JWT",
   "description": "Generate JSON web token",
   "help": "Use this action to generate JSON web token. Values for iat, exp and nbf will be rounded down to the nearest second.",
   "input": [
    {
     "name": "payload",
     "type": "object",
     "label": "Payload",
     "properties": [
      {
       "name": "sub",
       "type": "string",
       "label": "Subject(sub)",
       "control_type": "text"
      },
      {
       "name": "iat",
       "type": "date_time",
       "label": "Issued At(iat)",
       "control_type": "date_time"
      },
      {
       "name": "exp",
       "type": "date_time",
       "label": "Expiration Time(exp)",
       "control_type": "date_time"
      },
      {
       "name": "nbf",
       "type": "date_time",
       "label": "Not before Time(nbf)",
       "control_type": "date_time"
      },
      {
       "name": "iss",
       "type": "string",
       "label": "Issuer(iss)",
       "control_type": "text"
      },
      {
       "name": "aud",
       "type": "string",
       "label": "Audience(aud)",
       "control_type": "text"
      },
      {
       "name": "jti",
       "type": "string",
       "label": "JWT ID(jti)",
       "control_type": "text"
      },
      {
       "name": "scope",
       "type": "string",
       "label": "Scopes",
       "control_type": "text",
       "hint": "Space-separated list of scopes associated with the token as outlined in Section 3.3 of RFC6749 ."
      },
      {
       "name": "custom_claims",
       "type": "array",
       "label": "Custom claims",
       "control_type": "key_value",
       "of": "object",
       "properties": [
        {
         "name": "claim_name",
         "type": "string",
         "label": "Claim name",
         "control_type": "text",
         "required": true
        },
        {
         "name": "claim_value",
         "type": "string",
         "label": "Claim value",
         "control_type": "text",
         "required": true
        }
       ],
       "hint": "If the JWT token contains custom claims, provide the values below."
      }
     ]
    },
    {
     "name": "header",
     "type": "object",
     "label": "Header",
     "properties": [
      {
       "name": "kid",
       "type": "string",
       "label": "Key ID(kid)",
       "control_type": "text"
      },
      {
       "name": "nonce",
       "type": "string",
       "label": "Nonce",
       "control_type": "text"
      }
     ]
    }
   ],
   "output": [
    {
     "name": "jwt",
     "type": "string",
     "label": "JSON web token",
     "control_type": "text",
     "required": true
    }
   ]
  }
 ]
}
