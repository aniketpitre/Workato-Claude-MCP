{
 "name": "kizen",
 "title": "Kizen",
 "requires_connection": true,
 "categories": [
  "Business",
  "CRM",
  "Marketing",
  "Customer Service"
 ],
 "aliases": [
  "Kizen"
 ],
 "triggers": [
  {
   "name": "new_object",
   "title": "New object",
   "description": "New object in Kizen",
   "help": "Triggers when an object is created in Kizen.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "object",
     "type": "string",
     "label": "Object",
     "control_type": "select",
     "required": true,
     "pick_list": "kizen_objects",
     "extends_schema": true,
     "hint": "Select the object from picklist."
    },
    {
     "name": "pipeline",
     "type": "string",
     "label": "Pipeline",
     "control_type": "select",
     "visible_if": "input.object == \"deal\"",
     "pick_list": "pipelines",
     "extends_schema": true,
     "toggle_field": {
      "name": "pipeline",
      "type": "string"
     },
     "hint": "Required to filter deals."
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "extends_schema": true,
     "hint": "When you start recipe for the first time, it picks up trigger events from this specified date and time. Once recipe has been run or tested, value cannot be changed. If left blank, trigger picks up eve…"
    }
   ],
   "output": []
  }
 ],
 "actions": [
  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Kizen (Custom)",
   "help": "Build your own Kizen action with a HTTP request. The request will be authorized with your Kizen connection.",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
  {
   "name": "create_object",
   "title": "Create object",
   "description": "Create object in Kizen",
   "help": "Create object in Kizen.",
   "input": [
    {
     "name": "object",
     "type": "string",
     "label": "Object",
     "control_type": "select",
     "required": true,
     "pick_list": "kizen_objects",
     "extends_schema": true,
     "hint": "Select the object from picklist."
    }
   ],
   "output": []
  },
  {
   "name": "update_object",
   "title": "Update object",
   "description": "Update object in Kizen",
   "help": "Update object in Kizen.",
   "input": [
    {
     "name": "object",
     "type": "string",
     "label": "Object",
     "control_type": "select",
     "required": true,
     "pick_list": "kizen_objects",
     "extends_schema": true,
     "hint": "Select the object from picklist."
    }
   ],
   "output": []
  }
 ]
}
