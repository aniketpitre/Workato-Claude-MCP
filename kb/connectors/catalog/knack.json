 "triggers": [
  {
   "name": "new_record",
   "title": "New record",
   "description": "New record in Knack",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "object",
     "type": "string",
     "label": "Object",
     "control_type": "select",
     "required": true,
     "pick_list": "objects",
     "extends_schema": true
    },
    {
     "name": "is_user_role",
     "type": "number",
     "label": "Is user role",
     "control_type": "number",
     "required": true,
     "extends_schema": true,
     "hint": "True if 'object' is user roles"
    }
   ],
   "output": []
  }
