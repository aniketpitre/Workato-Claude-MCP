 "triggers": [
  {
   "name": "triggered_alerts",
   "title": "Triggered alerts",
   "description": "Triggered alerts in Librato",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    }
   ],
   "output": [
    {
     "name": "id",
     "type": "integer",
     "label": "ID",
     "control_type": "number"
    },
    {
     "name": "triggered_at",
     "type": "integer",
     "label": "Triggered at",
     "control_type": "number"
    }
   ]
  }
 ],
