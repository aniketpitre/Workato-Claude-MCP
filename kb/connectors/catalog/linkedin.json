     "type": "string",
     "label": "Submitter",
     "control_type": "text",
     "required": true
    },
    {
     "name": "associatedEntity",
     "type": "object",
     "label": "Associated entity",
     "required": true,
     "properties": [
      {
       "name": "sponsoredCreative",
       "type": "string",
       "label": "Sponsored creative",
       "control_type": "text",
       "required": true
      }
     ]
    },
