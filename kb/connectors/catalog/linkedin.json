  {
   "name": "get_lead_gen_forms_by_id",
   "title": "Get lead gen form response by ID",
   "description": "Get lead gen form response by ID in LinkedIn",
   "help": "Used to retrieve the full details of a lead gen form response, including the questions and answers.",
   "input": [
    {
     "name": "account",
     "type": "string",
     "label": "Advertising account",
     "control_type": "select",
     "required": true,
     "pick_list": "advertising_account",
     "toggle_field": {
      "name": "account",
      "type": "string"
     },
     "hint": "Select the advertising account to pick up form submissions from. Only the first 1000 accounts are shown. Toggle to provide the account URN manually if your account cannot be found."
    },
    {
     "name": "form_id",
     "type": "string",
     "label": "Form",
     "control_type": "select",
     "required": true,
     "pick_list": "lead_forms",
     "extends_schema": true,
     "toggle_field": {
      "name": "form_id",
      "type": "string"
     },
     "hint": "Select the form to which the responses are submitted. Only the first 1000 forms are returned. Toggle to provide the form URN manually if your form cannot be found."
    },
    {
     "name": "ad_form_response_id",
     "type": "string",
     "label": "Lead gen form response ID",
     "control_type": "text",
     "required": true,
     "hint": "Provide the ID of the lead gen form response. This can be found in the output of New lead gen form submitted trigger."
    }
   ],
   "output": []
  },
