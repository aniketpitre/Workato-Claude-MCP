 "triggers": [
  {
   "name": "new_lead_gen_form_response",
   "title": "New lead gen form submitted",
   "description": "New lead gen form submitted in LinkedIn",
   "help": "Triggers immediately when a Lead Gen Form is filled up from a lead. Lead Gen form submissions are tied to specific advertising accounts on LinkedIn and retrieve all form submissions across all creatives in this account. Each account or campaign can have only one trigger on Workato associated with it…",
   "input": [
    {
     "name": "account",
     "type": "string",
     "label": "Advertising account",
     "control_type": "select",
     "required": true,
     "pick_list": "advertising_account",
     "toggle_field": {
      "name": "account",
      "type": "string"
     },
     "hint": "Select the advertising account to pick up form submissions from. Only the first 1000 accounts are shown. Toggle to provide the account URN manually if your account cannot be found."
    },
    {
     "name": "form_id",
     "type": "string",
     "label": "Form",
     "control_type": "select",
     "pick_list": "versioned_lead_forms",
     "extends_schema": true,
     "toggle_field": {
      "name": "form_id",
      "type": "string"
     },
     "hint": "Select a form to load data tree. Only the first 1000 forms are returned. Toggle to provide the form URN manually if your form cannot be found."
    },
    {
     "name": "creative",
     "type": "string",
     "label": "Creative",
     "control_type": "select",
     "pick_list": "ad_creatives",
     "toggle_field": {
      "name": "creative",
      "type": "string"
     },
     "hint": "Select a creative to only pick up form submissions from this specified creative. Only the first 1000 creatives are returned. Toggle to provide the creative URN manually if your creative cannot be foun…"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "hint": "When you start recipe for the first time, it picks up trigger events from this specified date and time. Leave empty to get records created one hour ago. You can only retrieve leads created in the last…"
    }
   ],
   "output": [
    {
     "name": "submittedAt",
     "type": "date_time",
     "label": "Submitted at",
     "control_type": "date_time",
     "required": true
    },
    {
     "name": "id",
     "type": "string",
     "label": "Form response ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "leadType",
     "type": "string",
     "label": "Lead type",
     "control_type": "text",
     "required": true
    },
    {
     "name": "leadAction",
     "type": "string",
     "label": "Lead action",
     "control_type": "text",
     "required": true
    },
    {
