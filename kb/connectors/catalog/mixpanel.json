     "properties": [
      {
       "name": "distinct_id",
       "type": "string",
       "label": "Distinct ID",
       "control_type": "text",
       "required": true
      },
      {
       "name": "properties",
       "type": "object",
       "label": "Properties",
       "required": true,
       "properties": [
        {
         "name": "city",
         "type": "string",
         "label": "City",
         "control_type": "text",
         "required": true
        },
        {
         "name": "country_code",
         "type": "string",
         "label": "Country code",
         "control_type": "text",
         "required": true
        },
        {
         "name": "created",
         "type": "date_time",
         "label": "Created",
         "control_type": "date_time",
         "required": true
        },
        {
         "name": "email",
         "type": "string",
         "label": "Email",
         "control_type": "text",
         "required": true
        },
        {
         "name": "first_name",
         "type": "string",
         "label": "First name",
         "control_type": "text",
         "required": true
        },
        {
         "name": "last_name",
         "type": "string",
         "label": "Last name",
         "control_type": "text",
         "required": true
        },
        {
         "name": "region",
         "type": "string",
         "label": "Region",
         "control_type": "text",
         "required": true
        },
        {
         "name": "timezone",
         "type": "string",
         "label": "Timezone",
         "control_type": "text",
         "required": true
        },
        {
         "name": "user_id",
         "type": "string",
         "label": "User ID",
         "control_type": "text",
         "required": true
        },
        {
         "name": "last_seen",
         "type": "date_time",
         "label": "Last seen",
         "control_type": "date_time",
         "required": true
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "name": "set_property",
   "title": "Set property",
   "description": "Set property in Mixpanel",
   "input": [
    {
     "name": "property",
     "type": "string",
     "label": "Property type",
     "control_type": "select",
     "required": true,
     "options": [
      "user",
      "group"
     ],
     "extends_schema": true
    }
   ],
   "output": [
    {
     "name": "result",
     "type": "string",
     "label": "Result",
     "control_type": "text",
     "required": true
    }
   ]
  }
 ]
}
