{
 "name": "mixpanel",
 "title": "Mixpanel",
 "requires_connection": true,
 "categories": [
  "Business analytics",
  "Marketing"
 ],
 "aliases": [
  "Mixpanel"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Mixpanel (Custom)",
   "help": "Build your own Mixpanel action with a HTTP request.",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
  {
   "name": "get_funnel_data",
   "title": "Get funnel data",
   "description": "Get funnel data in Mixpanel",
   "input": [
    {
     "name": "funnel_id",
     "type": "string",
     "label": "Funnel",
     "control_type": "select",
     "required": true,
     "pick_list": "funnel_pick_list",
     "toggle_field": {
      "name": "funnel_name",
      "type": "string"
     }
    },
    {
     "name": "from_date",
     "type": "date_time",
     "label": "From date",
     "control_type": "date",
     "hint": "The first (inclusive) date from which a user can begin the first step in the funnel"
    },
    {
     "name": "to_date",
     "type": "date_time",
     "label": "To date",
     "control_type": "date",
     "hint": "The last (inclusive) date from which a user can begin the first step in the funnel. The date range may not be more than 90 days."
    },
    {
     "name": "interval",
     "type": "integer",
     "label": "Interval",
     "control_type": "text",
     "hint": "The number of days you want your results bucketed into. Defaults to 1"
    },
    {
     "name": "unit",
     "type": "string",
     "label": "Unit",
     "control_type": "text",
     "hint": "An alternate way of specifying interval and can be 'day' or 'week'"
    }
   ],
   "output": [
    {
     "name": "data",
     "type": "array",
     "label": "Data",
     "required": true,
     "of": "object",
     "properties": [
      {
       "name": "date",
       "type": "string",
       "label": "Date",
       "control_type": "text",
       "required": true
      },
      {
       "name": "steps",
       "type": "array",
       "label": "Steps",
       "required": true,
       "of": "object",
       "properties": [
        {
         "name": "count",
         "type": "integer",
         "label": "Count",
         "control_type": "number",
         "required": true
        },
        {
         "name": "step_conv_ratio",
         "type": "integer",
         "label": "Step conv ratio",
         "control_type": "number",
         "required": true
        },
        {
         "name": "goal",
         "type": "string",
         "label": "Goal",
         "control_type": "text",
         "required": true
        },
        {
         "name": "overall_conv_ratio",
         "type": "integer",
         "label": "Overall conv ratio",
         "control_type": "number",
         "required": true
        },
        {
         "name": "avg_time",
         "type": "integer",
         "label": "Avg time",
         "control_type": "number",
         "required": true
        },
        {
         "name": "event",
         "type": "string",
         "label": "Event",
         "control_type": "text",
         "required": true
        }
       ]
      },
      {
       "name": "analysis",
       "type": "object",
       "label": "Analysis",
       "required": true,
       "properties": [
        {
         "name": "completion",
         "type": "integer",
         "label": "Completion",
         "control_type": "text",
         "required": true
        },
        {
         "name": "starting_amount",
         "type": "integer",
         "label": "Starting amount",
         "control_type": "text",
         "required": true
        },
        {
         "name": "steps",
         "type": "integer",
         "label": "Steps",
         "control_type": "text",
         "required": true
        },
        {
         "name": "worst",
         "type": "integer",
         "label": "Worst",
         "control_type": "text",
         "required": true
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "name": "get_funnel_list",
   "title": "Get funnel list",
   "description": "Get funnel list in Mixpanel",
   "input": [],
   "output": [
    {
     "name": "funnels",
     "type": "array",
     "label": "Funnels",
     "required": true,
     "of": "object",
     "properties": [
      {
       "name": "funnel_id",
       "type": "integer",
       "label": "Funnel ID",
       "control_type": "number",
       "required": true
      },
      {
       "name": "name",
       "type": "string",
       "label": "Name",
       "control_type": "text",
       "required": true
      }
     ]
    }
   ]
  },
  {
   "name": "get_user_info",
