  {
   "name": "new_contact",
   "title": "New contact",
   "description": "New contact in Nimble CRM",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    }
   ],
   "output": [
    {
     "name": "id",
     "type": "string",
     "label": "ID",
     "control_type": "text",
     "required": true
    },
