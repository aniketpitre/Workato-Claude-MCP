{
 "name": "onprem_command_line_scripts",
 "title": "On-prem command-line scripts",
 "requires_connection": true,
 "categories": [
  "Document/File",
  "Marketing"
 ],
 "aliases": [
  "On-prem command-line scripts",
  "on premise",
  "scripts",
  "commands",
  "bash",
  "shell"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "execute_script",
   "title": "Execute command-line script",
   "description": "Execute command-line script",
   "help": "Execute on-prem command-line script.",
   "input": [
    {
     "name": "script_id",
     "type": "string",
     "label": "Command-line script",
     "control_type": "select",
     "required": true,
     "pick_list": "script_list_pick_list",
     "extends_schema": true,
     "hint": "Select a script"
    },
    {
     "name": "timeout",
     "type": "integer",
     "label": "Timeout limit (minutes)",
     "control_type": "integer",
     "visible_if": "input.background !=  \"true\"",
     "default": 2,
     "hint": "Defines maximum duration for script execution. If it takes longer than this, process will be terminated. Maximum is 1440 minutes (24 hours)."
    },
    {
     "name": "background",
     "type": "string",
     "label": "Run script in background?",
     "control_type": "checkbox",
     "hint": "Run script and return immediately without waiting for completion. Maximum allowed execution duration is limited by 24 hours."
    }
   ],
   "output": [
    {
     "name": "process_id",
     "type": "string",
     "label": "Process ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "exit_code",
     "type": "string",
     "label": "Exit code",
     "control_type": "text",
     "required": true
    },
    {
     "name": "system_out",
     "type": "string",
     "label": "System out",
     "control_type": "text",
     "required": true
    }
   ]
  }
 ]
}
