{
 "name": "open_ai_utility",
 "title": "AI by Workato",
 "requires_connection": false,
 "categories": [
  "Artificial Intelligence",
  "Workato"
 ],
 "aliases": [
  "AI by Workato"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "analyse_document",
   "title": "Analyze text",
   "description": "Analyze text to answer questions using AI by Workato",
   "help": "This action performs a contextual analysis of a text to answer user-provided questions. If the answer isn't found in the text, the datapill will be empty.",
   "input": [
    {
     "name": "text",
     "type": "string",
     "label": "Source text",
     "control_type": "text",
     "required": true,
     "hint": "Provide the text to be analysed."
    },
    {
     "name": "question",
     "type": "string",
     "label": "Instruction",
     "control_type": "text",
     "required": true,
     "hint": "Enter analysis instructions, such as an analysis technique or question to be answered."
    }
   ],
   "output": [
    {
     "name": "response",
     "type": "string",
     "label": "Analysis Result",
     "control_type": "text"
    },
    {
     "name": "remaining_calls",
     "type": "integer",
     "label": "Remaining calls",
     "control_type": "text",
     "required": true
    },
    {
     "name": "consumed_calls",
     "type": "integer",
     "label": "Consumed calls",
     "control_type": "text",
     "required": true
    },
    {
     "name": "reset_time",
     "type": "date_time",
     "label": "Reset time",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "analyse_image",
   "title": "Analyze image",
   "description": "Analyze image to answer questions using AI by Workato",
   "help": "This action analyses an image to answer user-provided questions. If the answer isn't found, the datapill will be empty. Supports file size upto 20 MB. Supported formats: png, jpg, jpeg, webp, gif, pdf . PDF file must be not more than 15 pages.",
   "input": [
    {
     "name": "file_contents",
     "type": "string",
     "label": "File contents",
     "control_type": "text",
     "required": true,
     "hint": "Provide file content to be analysed."
    },
    {
     "name": "file_name",
     "type": "string",
     "label": "File name",
     "control_type": "text",
     "hint": "Provide the file name with file extension or specify the type in File type ."
    },
    {
     "name": "file_type",
     "type": "string",
     "label": "File type",
     "control_type": "select",
     "options": [
      "png",
      "jpg",
      "jpeg",
      "webp",
      "gif",
      "pdf"
     ],
     "toggle_field": {
      "name": "file_type",
      "type": "string"
     },
     "hint": "Select the file type of the file contents. Overrides the inferred type from File name ."
    },
    {
     "name": "question",
     "type": "string",
     "label": "Instruction",
     "control_type": "text",
     "required": true,
     "hint": "Enter analysis instructions, such as an analysis technique or question to be answered."
    }
   ],
   "output": [
    {
     "name": "response",
     "type": "string",
     "label": "Analysis Result",
     "control_type": "text"
    },
    {
     "name": "remaining_calls",
     "type": "integer",
     "label": "Remaining calls",
     "control_type": "text",
     "required": true
    },
    {
     "name": "consumed_calls",
     "type": "integer",
     "label": "Consumed calls",
     "control_type": "text",
     "required": true
    },
    {
     "name": "reset_time",
     "type": "date_time",
     "label": "Reset time",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "categorise_text",
   "title": "Categorize text",
   "description": "Classify text based on user-defined categories using AI by Workato .",
   "help": "This action chooses one of the categories that best fits the input text. The output datapill will contain the value of the best match category or error if not found. If you want to have an option for none, please configure it explicitly.",
   "input": [
    {
     "name": "text",
     "type": "string",
     "label": "Text",
     "control_type": "text",
     "required": true,
     "hint": "Provide the text to be categorized"
    },
    {
     "name": "category_type",
     "type": "string",
     "label": "Category type",
     "control_type": "text",
     "extends_schema": true,
     "hint": "Enter the type of categories to sort the text into. Eg. Sentiment, Emotion, etc."
    },
    {
     "name": "object_schema",
     "type": "array",
     "label": "List of categories",
     "control_type": "key_value",
     "required": true,
     "of": "object",
     "properties": [
      {
       "name": "header",
       "type": "string",
       "label": "Category",
       "control_type": "text",
       "required": true,
       "extends_schema": true,
       "hint": "Enter category name"
      },
      {
       "name": "value",
       "type": "string",
       "label": "Description",
       "control_type": "text",
       "hint": "Enter description"
      }
     ],
     "hint": "Create a list of categories to sort the text into. Rules are used to provide additional details to help classify what each category represents."
    }
   ],
   "output": [
    {
     "name": "response",
     "type": "string",
     "label": "Best match category",
     "control_type": "text"
    },
    {
     "name": "remaining_calls",
     "type": "integer",
     "label": "Remaining calls",
     "control_type": "text",
     "required": true
    },
    {
     "name": "consumed_calls",
     "type": "integer",
     "label": "Consumed calls",
     "control_type": "text",
     "required": true
    },
    {
     "name": "reset_time",
     "type": "date_time",
     "label": "Reset time",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "draft_email",
   "title": "Draft email",
   "description": "Generate draft email in AI by Workato",
   "help": "This action generates an email and parses input into datapills containing a subject line and body for easy mapping into future recipe actions. Note that the body contains placeholder text for a salutation if this information isn't present in the email description.",
   "input": [
    {
     "name": "text",
     "type": "string",
     "label": "Email description",
     "control_type": "text",
     "required": true,
     "hint": "Enter a description for the email"
    }
   ],
   "output": [
    {
     "name": "subject",
     "type": "string",
     "label": "Subject",
     "control_type": "text",
     "hint": "Subject"
    },
    {
     "name": "body",
     "type": "string",
     "label": "Body",
     "control_type": "text",
     "hint": "Body"
    },
    {
     "name": "remaining_calls",
     "type": "integer",
     "label": "Remaining calls",
     "control_type": "text",
     "required": true
    },
    {
     "name": "consumed_calls",
     "type": "integer",
     "label": "Consumed calls",
     "control_type": "text",
     "required": true
    },
    {
     "name": "reset_time",
     "type": "date_time",
     "label": "Reset time",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "generate_chat_completion",
   "title": "Generate a chat completion",
   "description": "Generate a chat completion using AI by Workato",
   "help": "Uses the Chat Completions API: send the full message thread, get the model's reply, with tool calling and structured output. Widest compatibility across the underlying models.",
   "input": [
    {
     "name": "messages",
     "type": "array",
     "label": "Messages",
     "required": true,
     "of": "object",
     "properties": [
      {
       "name": "role",
       "type": "string",
       "label": "Role",
       "control_type": "text",
       "required": true,
       "hint": "system, developer, user, assistant, or tool"
      },
      {
       "name": "content",
       "type": "string",
       "label": "Content",
       "control_type": "text",
       "required": true,
       "hint": "Maximum length 10,485,760 characters"
      },
      {
       "name": "name",
       "type": "string",
       "label": "Name",
       "control_type": "text",
       "hint": "Participant name"
      },
      {
       "name": "tool_calls",
       "type": "array",
       "label": "Tool calls",
       "of": "object",
       "properties": [
        {
         "name": "id",
         "type": "string",
         "label": "ID",
         "control_type": "text"
        },
        {
         "name": "type",
         "type": "string",
         "label": "Type",
         "control_type": "text"
        },
        {
         "name": "function",
         "type": "object",
         "label": "Function",
         "properties": [
          {
           "name": "name",
           "type": "string",
           "label": "Name",
           "control_type": "text"
          },
          {
           "name": "arguments",
           "type": "string",
           "label": "Arguments",
           "control_type": "text"
          }
         ]
        }
       ]
      },
      {
       "name": "tool_call_id",
       "type": "string",
       "label": "Tool call ID",
       "control_type": "text"
      }
     ],
     "hint": "Message thread forming the conversation"
    },
    {
     "name": "temperature",
     "type": "number",
     "label": "Temperature",
     "control_type": "number",
     "hint": "Sampling temperature (0.0-2.0)"
    },
    {
     "name": "top_p",
     "type": "number",
     "label": "Top p",
     "control_type": "number",
     "hint": "Nucleus sampling (0.0-1.0)"
    },
    {
     "name": "max_completion_tokens",
     "type": "integer",
     "label": "Max completion tokens",
     "control_type": "number"
    },
    {
     "name": "frequency_penalty",
     "type": "number",
     "label": "Frequency penalty",
     "control_type": "number",
     "hint": "-2.0 to 2.0"
    },
    {
     "name": "presence_penalty",
     "type": "number",
     "label": "Presence penalty",
     "control_type": "number",
     "hint": "-2.0 to 2.0"
    },
    {
     "name": "tools",
     "type": "array",
     "label": "Tools",
     "of": "object",
     "properties": [
      {
       "name": "type",
       "type": "string",
       "label": "Type",
       "control_type": "text"
      },
      {
       "name": "function",
       "type": "object",
       "label": "Function",
       "properties": [
        {
         "name": "name",
         "type": "string",
         "label": "Name",
         "control_type": "text"
        },
        {
         "name": "description",
         "type": "string",
         "label": "Description",
         "control_type": "text"
        },
        {
         "name": "parameters",
         "type": "string",
         "label": "Parameters",
         "control_type": "text-area",
         "hint": "Function parameters as a JSON schema object"
        }
       ]
      }
     ],
     "hint": "Tools the model may call"
    },
    {
     "name": "tool_choice",
     "type": "string",
     "label": "Tool choice",
     "control_type": "text",
     "hint": "Tool selection strategy, e.g. auto, none, required"
    },
    {
     "name": "parallel_tool_calls",
     "type": "boolean",
     "label": "Parallel tool calls",
     "control_type": "checkbox",
     "toggle_field": {
      "name": "parallel_tool_calls",
      "type": "boolean"
     },
     "hint": "Requires Tools to be specified"
    },
    {
     "name": "response_format",
     "type": "object",
