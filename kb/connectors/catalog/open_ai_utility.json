    {
     "name": "seed",
     "type": "integer",
     "label": "Seed",
     "control_type": "number",
     "hint": "Seed for deterministic output"
    },
    {
     "name": "logprobs",
     "type": "boolean",
     "label": "Log probabilities",
     "control_type": "checkbox",
     "toggle_field": {
      "name": "logprobs",
      "type": "boolean"
     }
    },
    {
     "name": "top_logprobs",
     "type": "integer",
