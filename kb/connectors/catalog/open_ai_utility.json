     "control_type": "number",
     "hint": "0-5, requires log probabilities enabled"
    },
    {
     "name": "user",
     "type": "string",
     "label": "User",
     "control_type": "text",
     "hint": "End-user identifier for abuse tracking"
    },
    {
     "name": "metadata",
     "type": "string",
     "label": "Metadata",
     "control_type": "text-area",
