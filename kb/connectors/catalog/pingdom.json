{
 "name": "pingdom",
 "title": "Pingdom",
 "requires_connection": true,
 "categories": [
  "Application Monitoring",
  "Developer Tool"
 ],
 "aliases": [
  "Pingdom"
 ],
 "triggers": [
  {
   "name": "new_alert",
   "title": "New alert",
   "description": "New alert in Pingdom",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "required": true,
     "hint": "Once recipe has been run or tested, value cannot be changed. Learn more"
    }
   ],
   "output": [
    {
     "name": "checkid",
     "type": "integer",
     "label": "Check id",
     "control_type": "number"
    },
    {
     "name": "contactname",
     "type": "string",
     "label": "Contact name",
     "control_type": "text"
    },
    {
     "name": "contactid",
     "type": "integer",
     "label": "Contact id",
     "control_type": "number"
    },
    {
     "name": "time",
     "type": "integer",
     "label": "Time",
     "control_type": "number"
    },
    {
     "name": "via",
     "type": "string",
     "label": "Via",
     "control_type": "text"
    },
    {
     "name": "status",
     "type": "string",
     "label": "Status",
     "control_type": "text"
    },
    {
     "name": "messageshort",
     "type": "string",
     "label": "Message short",
     "control_type": "text"
    },
    {
     "name": "messagefull",
     "type": "string",
     "label": "Message Full",
     "control_type": "text"
    },
    {
     "name": "sentto",
     "type": "string",
     "label": "Sent to",
     "control_type": "text"
    }
   ]
  }
 ],
 "actions": [
  {
   "name": "get_detailed_check_information",
   "title": "Get detailed check information",
   "description": "Get Check Information in Pingdom",
   "input": [
    {
     "name": "checkid",
     "type": "integer",
     "label": "Enter your Check ID",
     "control_type": "number",
     "required": true,
     "hint": "Go to Monitering->Uptime->select the check you will get your Check Id in the url at the end"
    }
   ],
   "output": [
    {
     "name": "id",
     "type": "integer",
     "label": "ID",
     "control_type": "number"
    },
    {
     "name": "name",
     "type": "string",
     "label": "Name",
     "control_type": "text"
    },
    {
     "name": "resolution",
     "type": "integer",
     "label": "Resolution",
     "control_type": "number"
    },
    {
     "name": "hostname",
     "type": "string",
     "label": "Hostname",
     "control_type": "text"
    },
    {
     "name": "status",
     "type": "string",
     "label": "Status",
     "control_type": "text"
    },
    {
     "name": "sendtoemail",
     "type": "number",
     "label": "Send to email",
     "control_type": "number"
    },
    {
     "name": "sendtosms",
     "type": "number",
     "label": "Send to sms",
     "control_type": "number"
    },
    {
     "name": "sendtotwitter",
     "type": "number",
     "label": "Send to twitter",
     "control_type": "number"
    },
    {
     "name": "sendtoiphone",
     "type": "number",
     "label": "Send to iphone",
     "control_type": "number"
    },
    {
     "name": "sendtoandroid",
     "type": "number",
     "label": "Send to android",
     "control_type": "number"
    },
    {
     "name": "sendnotificationwhendown",
     "type": "integer",
     "label": "Send notification when down",
     "control_type": "number"
    },
    {
     "name": "notifyagainevery",
     "type": "integer",
     "label": "Notify again every",
     "control_type": "number"
    },
    {
     "name": "notifywhenbackup",
     "type": "number",
     "label": "Notify when backup",
     "control_type": "number"
    },
    {
     "name": "contactids",
     "type": "array",
     "label": "Contact IDS",
     "of": "object",
     "properties": [
      {
       "name": "id",
       "type": "integer",
       "label": "ID",
       "control_type": "number"
      }
     ]
    }
   ]
  }
 ]
}
