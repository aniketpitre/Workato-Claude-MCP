{
 "name": "plan_grid",
 "title": "PlanGrid",
 "requires_connection": true,
 "categories": [
  "Developer Tool"
 ],
 "aliases": [
  "PlanGrid"
 ],
 "triggers": [
  {
   "name": "new_object",
   "title": "New object in PlanGrid",
   "description": "New object in PlanGrid",
   "help": "Triggers when an object is created",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "object",
     "type": "string",
     "label": "Object",
     "control_type": "select",
     "required": true,
     "pick_list": "object_list",
     "extends_schema": true,
     "hint": "Select the object from picklist."
    }
   ],
   "output": []
  },
  {
   "name": "new_updated_object",
   "title": "New or updated object in PlanGrid",
   "description": "New or updated object in PlanGrid",
   "help": "Triggers when an object is created or updated",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
