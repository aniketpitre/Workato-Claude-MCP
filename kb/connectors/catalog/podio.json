 "triggers": [
  {
   "name": "new_item_new",
   "title": "New item",
   "description": "New item in Citrix Podio",
   "help": "Checks for new events every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "organization_id",
     "type": "string",
     "label": "Organization",
     "control_type": "select",
     "required": true,
     "pick_list": "organization_list"
    },
    {
     "name": "workspace_id",
     "type": "string",
     "label": "Workspace",
     "control_type": "select",
     "required": true,
     "pick_list": "workspace_list",
     "hint": "Select Organization"
    },
    {
     "name": "app_id",
     "type": "string",
     "label": "Application",
     "control_type": "select",
     "required": true,
     "pick_list": "space_app_list",
     "extends_schema": true,
     "hint": "Select Workspace"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date",
     "hint": "Earliest item time; default is all items. Once recipe has been run or tested, value cannot be changed. Learn more"
    }
   ],
   "output": [
    {
     "name": "item_id",
     "type": "number",
     "label": "Item ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "app_item_id",
     "type": "number",
     "label": "App item ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "external_id",
     "type": "string",
     "label": "External ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "title",
     "type": "string",
     "label": "Title",
     "control_type": "text",
     "required": true
    },
    {
     "name": "revision",
     "type": "string",
     "label": "Revision",
     "control_type": "text",
     "required": true
    },
    {
     "name": "link",
     "type": "string",
     "label": "Link",
     "control_type": "url",
     "required": true
    },
    {
     "name": "created_on",
     "type": "date_time",
     "label": "Created on",
     "control_type": "date_time",
     "required": true
    },
    {
     "name": "last_edit_on",
     "type": "date_time",
     "label": "Last edit on",
     "control_type": "date_time",
     "required": true
    }
   ]
  },
