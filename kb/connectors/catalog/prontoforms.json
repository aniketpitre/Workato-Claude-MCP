{
 "name": "prontoforms",
 "title": "Prontoforms",
 "requires_connection": true,
 "categories": [
  "Forms",
  "Marketing"
 ],
 "aliases": [
  "Prontoforms"
 ],
 "triggers": [
  {
   "name": "new_form",
   "title": "New form",
   "description": "New form in Prontoforms",
   "help": "Questions of image and file types return base64 encoded byte stream. To decode, use `.decode_base64` in formula mode.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "form",
     "type": "string",
     "label": "Form",
     "control_type": "select",
     "required": true,
     "pick_list": "get_form_list",
     "extends_schema": true
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "hint": "Get form created since the given date/time.Leave empty to get forms created 1 hour ago. Once recipe has been run or tested, value cannot be changed. Learn more"
    }
   ],
   "output": [
    {
     "name": "identifier",
     "type": "string",
     "label": "Identifier",
     "control_type": "text",
     "required": true
    },
    {
     "name": "referenceNumber",
     "type": "string",
     "label": "Reference number",
     "control_type": "text",
     "required": true
    },
    {
     "name": "state",
     "type": "string",
     "label": "State",
     "control_type": "text",
     "required": true
    },
    {
     "name": "actionState",
     "type": "string",
     "label": "Action state",
     "control_type": "text",
     "required": true
    },
    {
     "name": "formVersionId",
     "type": "string",
     "label": "Form version ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "formId",
     "type": "string",
     "label": "Form ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "userId",
     "type": "string",
     "label": "User ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "username",
     "type": "string",
     "label": "Username",
     "control_type": "text",
     "required": true
    },
    {
     "name": "dataPersisted",
     "type": "boolean",
     "label": "Data persisted",
     "control_type": "checkbox",
     "required": true,
     "toggle_field": {
      "name": "dataPersisted",
      "type": "boolean"
     }
    },
    {
     "name": "serverReceiveDate",
     "type": "date_time",
     "label": "Server receive date",
     "control_type": "date",
     "required": true
    }
   ]
  }
 ],
 "actions": [
  {
   "name": "dispatch_form",
   "title": "Dispatch form",
   "description": "Dispatch form in Prontoforms",
   "input": [
    {
     "name": "form",
     "type": "string",
     "label": "Form",
     "control_type": "select",
     "required": true,
     "pick_list": "get_form_list",
     "extends_schema": true,
     "hint": "Select a form for which Initiation method is set as 'Dispatch' or 'Both'"
    },
    {
     "name": "username",
     "type": "string",
     "label": "Username",
     "control_type": "text",
     "required": true
    },
    {
     "name": "dispatchToDraft",
     "type": "boolean",
     "label": "Dispatch to draft",
     "control_type": "checkbox",
     "required": true,
     "toggle_field": {
      "name": "dispatchToDraft",
      "type": "boolean"
     }
    }
   ],
   "output": [
    {
     "name": "dataId",
     "type": "string",
     "label": "Data ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "referenceNumber",
     "type": "string",
     "label": "Reference number",
     "control_type": "text",
     "required": true
    }
   ]
  }
 ]
}
