  {
   "name": "call_ended",
   "title": "Call ended",
   "description": "Call ended in RingCentral",
   "help": "Retrieves ended calls by connected RingCentral extension. Trigger checks for ended calls every {{authUser.membership.poll_interval}} minutes. Connected RingCentral extension requires ReadCallLog permissions, which is usually enabled for predefined or default RingCentral roles.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "hint": "Retrieves calls ended since this time. If blank, defaults to one hour before the time when recipe is first started. Once recipe has been run or tested, value cannot be changed. Learn more"
    }
   ],
