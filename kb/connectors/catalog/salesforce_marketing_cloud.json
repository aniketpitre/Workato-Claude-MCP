  {
   "name": "new_data_extension_row",
   "title": "New data extension row",
   "description": "New data extension row in Salesforce Marketing Cloud",
   "help": "Checks for new data extension row every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "key",
     "type": "string",
     "label": "Data extension",
     "control_type": "select",
     "required": true,
     "pick_list": "data_extensions",
     "toggle_field": {
      "name": "key",
      "type": "string"
     }
    },
    {
     "name": "field_list",
     "type": "string",
     "label": "Primary key field",
     "control_type": "multiselect",
     "required": true,
     "pick_list": "fields_list",
     "extends_schema": true,
     "hint": "Primary key will be used to distinguish new records from records already processed by the recipe. Typically a unique field, e.g. record ID."
    },
    {
     "name": "output_field_list",
     "type": "string",
     "label": "Fields",
     "control_type": "multiselect",
     "pick_list": "fields_list",
     "extends_schema": true,
     "hint": "Select the fields that are returned with this trigger. All fields will be returned if left blank."
    }
   ],
   "output": []
  }
 ],
