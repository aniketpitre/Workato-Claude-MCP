{
 "name": "sendgrid",
 "title": "SendGrid",
 "requires_connection": true,
 "categories": [
  "Marketing",
  "Developer Tool"
 ],
 "aliases": [
  "SendGrid"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in SendGrid (Custom)",
   "help": "Build your own SendGrid action with a HTTP request. The request will be authorized with your SendGrid connection.",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
