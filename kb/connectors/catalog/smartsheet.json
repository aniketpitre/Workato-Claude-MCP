 "actions": [
  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Smartsheet (Custom)",
   "help": "Build your own Smartsheet action with a HTTP request. The request will be authorized under your Smartsheet connection OAuth scopes: Scopes sheet:read, sheet:write, sheet:create, webhook:read, webhook:write",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
  {
   "name": "create_row",
   "title": "Create row",
   "description": "Create row in Smartsheet",
   "input": [
    {
     "name": "sheet_id",
     "type": "string",
     "label": "Sheet name",
     "control_type": "select",
     "required": true,
     "pick_list": "sheets",
     "extends_schema": true,
     "toggle_field": {
      "name": "sheet_id",
      "type": "integer"
     }
    }
   ],
   "output": []
  },
