  {
   "name": "new_or_updated_row",
   "title": "New or updated row in a sheet",
   "description": "New or updated row in a sheet in Smartsheet",
   "help": "Fetch new or updated row events in real-time as soon as they occur. Events that occur when the recipe is stopped will not be processed. Use Get row by ID action for more details.",
   "input": [
    {
     "name": "sheet_id",
     "type": "string",
     "label": "Sheet name",
     "control_type": "select",
     "required": true,
     "pick_list": "sheets",
     "extends_schema": true,
     "toggle_field": {
      "name": "sheet_id",
      "type": "string"
     }
    },
    {
     "name": "watchfield",
     "type": "string",
     "label": "Columns to monitor",
     "control_type": "multiselect",
     "pick_list": "columns_list",
     "extends_schema": true,
     "hint": "Select one or more columns to monitor for changes. When a cell is changed, the corresponding row will trigger the recipe. Defaults to all columns."
    }
   ],
   "output": [
    {
     "name": "objectType",
     "type": "string",
     "label": "Object type",
     "control_type": "text"
    },
    {
     "name": "eventType",
     "type": "string",
     "label": "Event type",
     "control_type": "text"
    },
    {
     "name": "id",
     "type": "integer",
     "label": "Row ID",
     "control_type": "number"
    },
    {
     "name": "userId",
     "type": "integer",
     "label": "User ID",
     "control_type": "number"
    },
    {
