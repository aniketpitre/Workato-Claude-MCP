  {
   "name": "new_timesheet",
   "title": "New timesheet",
   "description": "New timesheet in TSheets",
   "help": "Trigger picks timesheet entries created since the specified time. Updated timesheet entries will also be picked if they are not picked previously by the recipe",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "on_the_clock",
     "type": "string",
     "label": "Work status",
     "control_type": "select",
     "options": [
      "yes",
      "no",
      "both"
     ],
     "hint": "Pick events based on the working status. Default is 'Currently not working'"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "hint": "Leave empty to pick timesheet entries created 1 hour ago . Once recipe has been run or tested, value cannot be changed. Learn more"
    }
   ],
