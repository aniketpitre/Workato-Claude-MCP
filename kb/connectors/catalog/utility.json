{
 "name": "utility",
 "title": "Utilities",
 "requires_connection": false,
 "categories": [
  "Recipe Tools"
 ],
 "aliases": [
  "Utilities",
  "utility",
  "workato"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "format_name",
   "title": "Merge name components",
   "description": "Merge name components based on separator",
   "input": [
    {
     "name": "order",
     "type": "string",
     "label": "Order",
     "control_type": "select",
     "required": true,
     "default": "f,l",
     "options": [
      "f,l",
      "l,f",
      "f,m,l",
      "l,f,m"
     ],
     "toggle_field": {
      "name": "order",
      "type": "string"
     },
     "hint": "If separator is ',' output will be 'John,Smith'"
    },
    {
     "name": "first_name",
     "type": "string",
     "label": "First name",
     "control_type": "text",
     "hint": "Input first name value"
    },
    {
     "name": "middle_name",
     "type": "string",
     "label": "Middle name",
     "control_type": "text",
     "hint": "Input middle name value"
    },
    {
     "name": "last_name",
     "type": "string",
     "label": "Last name",
     "control_type": "text",
     "hint": "Input last name value"
    },
    {
     "name": "separator",
     "type": "string",
     "label": "Separator",
     "control_type": "text",
     "hint": "The separator to insert between the first name, middle name and last name. Defaults to space."
    }
   ],
   "output": [
    {
     "name": "formatted_name",
     "type": "string",
     "label": "Formatted name",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "log_message",
   "title": "Log message",
   "description": "Log message to output",
   "help": "Displays text and data passed into the message field in the job output. Useful for testing and debugging.",
   "input": [
    {
     "name": "message",
     "type": "string",
     "label": "Message",
     "control_type": "text",
     "required": true,
     "hint": "Text to be logged to the output"
    }
   ],
   "output": [
    {
     "name": "message",
     "type": "string",
     "label": "Message",
     "control_type": "text",
     "required": true
    }
   ]
  }
 ]
}
