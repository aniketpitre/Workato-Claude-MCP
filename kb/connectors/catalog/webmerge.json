{
 "name": "webmerge",
 "title": "Formstack Documents",
 "requires_connection": true,
 "categories": [
  "Document/File",
  "Sales Enablement"
 ],
 "aliases": [
  "Formstack Documents"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "merge_document",
   "title": "Merge document",
   "description": "Merge document in Formstack Documents",
   "help": "Webmerge returns the merged document as response in some cases, use the Document pill to access it.",
   "input": [
    {
     "name": "document_id",
     "type": "string",
     "label": "Document name",
     "control_type": "select",
     "required": true,
     "pick_list": "documents",
     "extends_schema": true
    }
   ],
   "output": [
    {
     "name": "success",
     "type": "integer",
     "label": "Success",
     "control_type": "number"
    },
    {
     "name": "queued",
     "type": "integer",
     "label": "Queued",
     "control_type": "number"
    },
    {
     "name": "content",
     "type": "string",
     "label": "Document",
     "control_type": "text"
    }
   ]
  },
  {
   "name": "merge_route",
   "title": "Merge route",
   "description": "Merge route in Formstack Documents",
   "input": [
    {
     "name": "route_id",
     "type": "string",
     "label": "Route name",
     "control_type": "select",
     "required": true,
     "pick_list": "routes",
     "extends_schema": true
    }
   ],
   "output": [
    {
     "name": "success",
     "type": "integer",
     "label": "Success",
     "control_type": "number"
    }
   ]
  }
 ]
}
