 "triggers": [
  {
   "name": "new_transactions_in_polling_bucket_batch",
   "title": "New transactions in polling bucket",
   "description": "New transactions in polling bucket in Workato EDI",
   "help": "Triggers when new transactions appear in a polling bucket and returns them in configurable batches. Automatically approves each transaction's delivery to remove it from the bucket, preventing duplicate processing. Checks for new transactions every {{authUser.membership.poll_interval}} minutes.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "bucketId",
     "type": "integer",
     "label": "Bucket ID",
     "control_type": "integer",
     "required": true,
     "hint": "The ID of the polling bucket to monitor for new transactions."
    },
    {
     "name": "batch_size",
     "type": "integer",
     "label": "Batch size",
     "control_type": "integer",
     "default": 100,
     "hint": "Number of transactions per batch between 1 and 100. Defaults to 100 if left blank."
    }
   ],
   "output": [
    {
     "name": "records",
     "type": "array",
     "label": "Transactions",
     "required": true,
     "of": "object",
     "properties": [
      {
       "name": "id",
       "type": "string",
       "label": "Transaction ID",
       "control_type": "text",
       "required": true
      },
      {
       "name": "href",
       "type": "string",
       "label": "URL",
       "control_type": "text",
       "required": true
      },
      {
       "name": "version",
       "type": "string",
       "label": "Version",
       "control_type": "text",
       "required": true
      },
      {
       "name": "sender",
       "type": "object",
       "label": "Sender",
       "required": true,
       "properties": [
        {
         "name": "isaId",
         "type": "string",
         "label": "Interchange control header (ISA) ID",
         "control_type": "text",
         "required": true
        },
        {
         "name": "isaIdQualifier",
         "type": "string",
         "label": "Interchange control header (ISA) ID qualifier",
         "control_type": "text",
         "required": true
        },
        {
         "name": "testIsaId",
         "type": "string",
         "label": "Test Interchange control header (ISA) ID",
         "control_type": "text",
         "required": true
        },
        {
         "name": "testIsaIdQualifier",
         "type": "string",
         "label": "Test Interchange control header (ISA) ID qualifier",
         "control_type": "text",
         "required": true
        },
        {
         "name": "name",
         "type": "string",
         "label": "Name",
         "control_type": "text",
         "required": true
        }
       ]
      },
      {
       "name": "receiver",
       "type": "object",
       "label": "Receiver",
       "required": true,
       "properties": [
        {
         "name": "isaId",
         "type": "string",
         "label": "Interchange control header (ISA) ID",
         "control_type": "text",
         "required": true
