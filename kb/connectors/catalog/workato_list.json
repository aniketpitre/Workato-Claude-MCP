{
 "name": "workato_list",
 "title": "Lists by Workato",
 "requires_connection": false,
 "categories": [
  "Recipe Tools",
  "Workato"
 ],
 "aliases": [
  "Lists by Workato",
  "utility",
  "utilities"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "accumulate_list_items",
   "title": "Accumulate items to list",
   "description": "Accumulate items to list",
   "help": "Use this action to create a list by iterating through an existing list. Each call to this action, appends one item to a list. You can select the fields that form the new list item.",
   "input": [
    {
     "name": "name",
     "type": "string",
     "label": "List name",
     "control_type": "text",
     "required": true,
     "extends_schema": true
    },
    {
     "name": "list_item",
     "type": "object",
     "label": "List item fields",
     "control_type": "form-schema-builder",
     "required": true,
     "properties": [
      {
       "name": "schema",
       "type": "string",
       "label": "Schema",
       "control_type": "text",
       "required": true,
       "extends_schema": true
      },
      {
       "name": "data",
       "type": "object",
       "label": "Data",
       "required": true
      }
     ]
    }
   ],
   "output": []
  },
  {
   "name": "create_list",
   "title": "Create repeat helper list",
   "description": "Create repeat helper list",
   "help": "Create a list (array) of a specified size. The list can then be used in the action to loop through a set of actions for a fixed number of times.",
   "input": [
    {
     "name": "size",
     "type": "integer",
     "label": "Size",
     "control_type": "text",
     "required": true,
     "hint": "Size of the list. Maximum allowed size is 50,000"
    }
   ],
   "output": [
    {
     "name": "list",
     "type": "array",
     "label": "List",
     "required": true,
     "of": "object",
     "properties": [
      {
       "name": "seq_no",
       "type": "integer",
       "label": "Seq no",
       "control_type": "text",
       "required": true
      }
     ]
    }
   ]
  }
 ]
}
