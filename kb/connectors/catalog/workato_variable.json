{
 "name": "workato_variable",
 "title": "Variables by Workato",
 "requires_connection": false,
 "categories": [
  "Recipe Tools",
  "Workato"
 ],
 "aliases": [
  "Variables by Workato",
  "utility",
  "utilities",
  "list",
  "variable"
 ],
 "triggers": [],
 "actions": [
  {
   "name": "clear_list",
   "title": "Clear all items from list",
   "description": "Clear all items from list",
   "help": "Clear all items from list.",
   "input": [
    {
     "name": "name",
     "type": "string",
     "label": "List name",
     "control_type": "select",
     "required": true,
     "pick_list": "$$_line_list",
     "extends_schema": true,
     "hint": "Select list to clear"
    }
   ],
   "output": []
  },
  {
   "name": "declare_list",
   "title": "Create list",
   "description": "Create list",
   "help": "Use this action to Create an empty list with item schema.",
   "input": [
    {
     "name": "name",
     "type": "string",
     "label": "List name",
     "control_type": "text",
     "required": true,
     "extends_schema": true,
     "hint": "Eg: orders/users etc."
    },
    {
     "name": "list_item_schema_json",
     "type": "string",
     "label": "List item schema",
     "control_type": "schema-designer",
     "required": true,
     "extends_schema": true,
     "hint": "Describe list item schema"
    }
   ],
   "output": []
  },
  {
   "name": "declare_variable",
   "title": "Create variable",
   "description": "Create variable",
   "input": [
    {
     "name": "name",
     "type": "string",
     "label": "Variable name",
     "control_type": "text",
     "required_when_visible": true,
     "visible_if": "input.name",
     "extends_schema": true,
     "hint": "Eg: order_total/item_count etc."
    },
    {
     "name": "type",
     "type": "string",
     "label": "Variable type",
     "control_type": "select",
     "required_when_visible": true,
     "visible_if": "input.name",
     "options": [
      "string",
      "integer",
      "number",
      "date",
      "date_time",
      "boolean"
     ],
     "extends_schema": true,
     "hint": "Select the variable type"
    }
   ],
   "output": []
  },
  {
   "name": "insert_to_list",
   "title": "Add items to list",
   "description": "Add items to list",
   "help": "Add items to list.",
   "input": [
    {
     "name": "name",
     "type": "string",
     "label": "List name",
     "control_type": "select",
     "required": true,
     "pick_list": "$$_line_list",
     "extends_schema": true,
     "hint": "Select list to update"
    },
    {
     "name": "location",
     "type": "string",
     "label": "Insert location",
     "control_type": "select",
     "required": true,
     "default": "end",
     "options": [
      "end",
      "start"
     ]
    }
   ],
   "output": []
  },
  {
   "name": "insert_to_list_batch",
   "title": "Add items to list",
   "description": "Add items to list",
   "help": "Add multiple items to list.",
   "input": [
    {
     "name": "name",
     "type": "string",
     "label": "List name",
     "control_type": "select",
     "required": true,
     "pick_list": "$$_line_list",
     "extends_schema": true,
     "hint": "Select list to update"
    },
    {
     "name": "location",
     "type": "string",
     "label": "Insert location",
     "control_type": "select",
     "required": true,
     "default": "end",
     "options": [
      "end",
      "start"
     ]
    }
   ],
   "output": []
  },
  {
   "name": "update_variables",
   "title": "Update variables",
   "description": "Update variables",
   "help": "Use this action to update the value of declared variables.",
   "input": [
    {
     "name": "name",
     "type": "string",
     "label": "Variable name",
     "control_type": "multiselect",
     "required": true,
     "pick_list": "$$_line_list",
     "extends_schema": true,
     "hint": "Select a variable created in an earlier step"
    },
    {
     "name": "input_mode",
     "type": "string",
     "label": "Input mode",
     "control_type": "select",
     "default": "raw",
     "options": [
      "raw",
      "structured"
     ],
     "extends_schema": true,
     "hint": "Structured mode provides individual inputs for each fields. Raw mode provides a single input for the complete payload."
    }
   ],
   "output": []
  }
 ]
}
