{
 "name": "workato_webhooks",
 "title": "Webhooks",
 "requires_connection": false,
 "categories": [
  "Developer Tool",
  "API Integration",
  "Marketing",
  "Workato"
 ],
 "aliases": [
  "Webhooks",
  "rest",
  "webhooks"
 ],
 "triggers": [
  {
   "name": "new_event",
   "title": "New event via webhook",
   "description": "New event via HTTP webhook",
   "help": "This trigger executes recipe actions when webhooks are received. When a recipe is stopped, it will not process webhooks.",
   "input": [
    {
     "name": "webhook_suffix",
     "type": "string",
     "label": "Event name",
     "control_type": "text",
     "required": true,
     "extends_schema": true
    },
    {
     "name": "request",
     "type": "object",
     "label": "Payload configuration",
     "required": true,
     "properties": [
      {
       "name": "webhook_type",
       "type": "string",
       "label": "Webhook type",
       "control_type": "select",
       "required": true,
       "default": "json",
       "options": [
        "get",
        "json",
        "xml",
        "form",
        "rawdata",
        "rawdatatxt"
       ],
       "extends_schema": true,
       "hint": "Select the HTTP method and payload data type used by webhook. Learn more"
      }
     ]
    }
   ],
   "output": []
  }
 ],
 "actions": []
}
