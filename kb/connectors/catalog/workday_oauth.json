{
 "name": "workday_oauth",
 "title": "Workday Web Services",
 "requires_connection": true,
 "categories": [
  "HR management",
  "ERP",
  "Financial Management",
  "Sales Enablement"
 ],
 "aliases": [
  "Workday Web Services"
 ],
 "triggers": [
  {
   "name": "new_updated_object",
   "title": "New/updated business object",
   "description": "New/updated business object in Workday",
   "help": "Order of jobs is unsorted.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "hint": "When left blank, trigger will start picking up updates created or updated 1 hour ago. Once recipe has been run or tested, value cannot be changed. Learn more"
    },
    {
     "name": "web_service",
     "type": "string",
     "label": "Business object",
     "control_type": "select",
     "required": true,
     "pick_list": "trigger_objects",
     "extends_schema": true
    }
   ],
   "output": []
  },
  {
   "name": "new_updated_object_batch",
   "title": "New/updated business object",
   "description": "New/updated business object in Workday",
   "help": "Trigger will retrieve records created/updated since the last time recipe triggered.Maximum batch size is 100 records. Order of jobs is unsorted.",
   "input": [
    {
     "name": "___poll_interval",
     "type": "integer",
     "label": "Trigger poll interval",
     "control_type": "select",
     "options": [
      5,
      15,
      30,
      60,
      120,
      180,
      240,
      360,
      480,
      720,
      1440,
      2880,
      10080,
      43200
     ],
     "toggle_field": {
      "name": "___poll_interval",
      "type": "integer"
     },
     "hint": "How frequently to check for new events. Defaults to {{authUser.membership.poll_interval}} minutes if left blank. Minimum value allowed is {{authUser.membership.min_poll_interval}} minutes. Learn more …"
    },
    {
     "name": "since",
     "type": "date_time",
     "label": "When first started, this recipe should pick up events from",
     "control_type": "date_time",
     "hint": "When left blank, trigger will start picking up updates created or updated 1 hour ago. Once recipe has been run or tested, value cannot be changed. Learn more"
    },
    {
     "name": "web_service",
     "type": "string",
     "label": "Business object",
     "control_type": "select",
     "required": true,
     "pick_list": "trigger_objects",
     "extends_schema": true
    },
    {
     "name": "batch_size",
     "type": "integer",
     "label": "Batch size",
     "control_type": "number",
     "hint": "Number of records in a single trigger event, default is 50 and maximum batch size is 100."
    }
   ],
   "output": [
    {
     "name": "first_id",
     "type": "string",
     "label": "First ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "last_id",
     "type": "string",
     "label": "Last ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "first_batch",
     "type": "boolean",
     "label": "First batch",
     "control_type": "checkbox",
     "required": true,
     "toggle_field": {
      "name": "first_batch",
      "type": "boolean"
     }
    },
    {
     "name": "last_batch",
     "type": "boolean",
     "label": "Last batch",
     "control_type": "checkbox",
     "required": true,
     "toggle_field": {
      "name": "last_batch",
      "type": "boolean"
     }
    },
    {
     "name": "total_records",
     "type": "integer",
     "label": "Total records",
     "control_type": "number",
     "required": true
    }
   ]
  }
 ],
