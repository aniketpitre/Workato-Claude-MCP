     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
  {
   "name": "read_rows",
   "title": "Read rows",
   "description": "Read rows in Xactly",
   "help": "Get rows based on given query",
   "input": [
    {
     "name": "table_name",
     "type": "string",
     "label": "Table name",
     "control_type": "select",
     "required": true,
     "pick_list": "tables",
     "extends_schema": true
    },
    {
     "name": "joint_table_name",
     "type": "string",
     "label": "Join table name",
     "control_type": "multiselect",
     "pick_list": "tables",
     "extends_schema": true
    }
   ],
   "output": []
  }
 ]
