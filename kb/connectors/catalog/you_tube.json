    {
     "name": "endDate",
     "type": "date",
     "label": "End date",
     "control_type": "date",
     "required": true,
     "hint": "End date for analytics data"
    },
    {
     "name": "metrics",
     "type": "string",
     "label": "Metrics",
     "control_type": "multiselect",
     "pick_list": "analytics_metrics",
     "toggle_field": {
      "name": "metrics",
      "type": "string"
     },
     "hint": "Metrics to retrieve. Leave empty for default metrics."
    },
    {
     "name": "dimensions",
     "type": "string",
     "label": "Dimensions",
     "control_type": "multiselect",
     "pick_list": "analytics_dimensions",
     "toggle_field": {
      "name": "dimensions",
      "type": "string"
     },
     "hint": "Dimensions for grouping data."
    },
    {
     "name": "filters",
     "type": "string",
     "label": "Filters",
     "control_type": "text",
     "hint": "Filters parameter (e.g., video==videoID;country==IN)"
    },
    {
     "name": "sort",
     "type": "string",
     "label": "Sort",
     "control_type": "text",
     "hint": "Sort parameter (e.g., -views for descending views, day for ascending by day)"
