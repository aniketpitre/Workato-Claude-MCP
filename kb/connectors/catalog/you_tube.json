  {
   "name": "download_caption_track",
   "title": "Download caption track",
   "description": "Download caption track from YouTube",
   "help": "Downloads the raw content of a caption track in the requested format (SRT, SBV, or VTT). Requires OAuth 2.0 with the \"Force SSL\" scope (youtube.force-ssl). Use \"List video caption tracks\" first to get the caption ID.",
   "input": [
    {
     "name": "captionId",
     "type": "string",
     "label": "Caption ID",
     "control_type": "text",
     "required": true,
     "hint": "ID of the caption track to download. Get this from \"List video caption tracks\"."
    },
    {
     "name": "format",
     "type": "string",
     "label": "Format",
     "control_type": "select",
     "pick_list": "caption_formats",
     "toggle_field": {
      "name": "format",
      "type": "string"
     },
     "hint": "Caption file format. Allowed values: srt , sbv , vtt . Default: track's native format (varies by caption track)."
    }
   ],
   "output": [
    {
     "name": "captionId",
     "type": "string",
     "label": "Caption ID",
     "control_type": "text",
     "required": true
    },
    {
     "name": "format",
     "type": "string",
     "label": "Format",
     "control_type": "text",
     "required": true
    },
    {
     "name": "content",
     "type": "string",
     "label": "Caption content (raw text)",
     "control_type": "text",
     "required": true
    }
   ]
  },
  {
   "name": "get_analytics",
   "title": "Get analytics",
   "description": "Get analytics data for resource in YouTube",
   "help": "Get comprehensive analytics data for your YouTube videos or channel. This action uses the YouTube Analytics API and requires OAuth authentication. Note: Analytics data is only available for your own content. This is a YouTube API restriction that ensures privacy of analytics data.",
