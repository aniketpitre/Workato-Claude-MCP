  {
   "name": "__adhoc_http_action",
   "title": "Custom action",
   "description": "Custom action in Zenefits (Custom)",
   "help": "Build your own Zenefits action with a HTTP request. The request will be authorized under your Zenefits connection OAuth scopes: Scopes platform, companies, companies.legal_name, companies.legal_address, companies.ein, people, people.work_email, people.status, people.location, people.personal_email, …",
   "input": [
    {
     "name": "mnemonic",
     "type": "string",
     "label": "Action name",
     "control_type": "text",
     "required": true,
     "default": "Custom action",
     "extends_schema": true,
     "hint": "Give this action you're building a descriptive name, e.g. create record, get record"
    },
    {
     "name": "verb",
     "type": "string",
     "label": "Method",
     "control_type": "select",
     "required": true,
     "options": [
      "get",
      "post",
      "put",
      "patch",
      "delete",
      "head"
     ],
     "extends_schema": true,
     "hint": "Select HTTP method of the request"
    }
   ],
   "output": []
  },
